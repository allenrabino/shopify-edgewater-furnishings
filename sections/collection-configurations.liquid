
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} collection-configurations spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="collection-configurations__header page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="collection-configurations__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="collection-configurations__title">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading }}
      {%- else -%}
        {{ collection.title }}
      {%- endif -%}
    </h1>
    {%- if section.settings.description != blank -%}
      <div class="collection-configurations__description rte">{{ section.settings.description }}</div>
    {%- elsif collection.description != blank -%}
      <div class="collection-configurations__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  <div
    class="collection-configurations__grid page-width"
    style="--configuration-columns: {{ section.settings.columns }};"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .collection-configurations__header {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--gap-2xl);
  }

  .collection-configurations__eyebrow {
    margin: 0 0 var(--gap-sm);
    font-size: var(--font-size--xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .collection-configurations__title {
    margin: 0 0 var(--gap-md);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .collection-configurations__description {
    font-size: var(--font-size--md);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    line-height: 1.6;
  }

  .collection-configurations__grid {
    display: grid;
    grid-template-columns: repeat(var(--configuration-columns, 3), minmax(0, 1fr));
    gap: var(--gap-xl) var(--gap-lg);
  }

  @media screen and (max-width: 989px) {
    .collection-configurations__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .collection-configurations__grid {
      grid-template-columns: 1fr;
      gap: var(--gap-lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_configurations",
  "class": "ui-test-collection-configurations",
  "blocks": [
    {
      "type": "_configuration-item"
    },
    {
      "type": "text"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:info.collection_configurations_heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_configurations"
    }
  ]
}
{% endschema %}
