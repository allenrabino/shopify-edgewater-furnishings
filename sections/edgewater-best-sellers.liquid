{%- liquid
  assign products = section.settings.products
  assign max_products = section.settings.max_products | default: 10

  if products == blank or products.size == 0
    if section.settings.collection != blank
      assign products = section.settings.collection.products
    else
      assign default_handles = '4pc-sofa-ottoman,5pc-l-shape-ottoman,6pc-corner-sectional-ottoman,3pc-sofa-ottoman,5pc-double-ottoman,6pc-pit' | split: ','
    endif
  endif

  assign use_default_handles = false
  if products == blank or products.size == 0
    if default_handles != blank
      assign use_default_handles = true
      assign slide_count = default_handles.size
    endif
  else
    assign slide_count = products.size
  endif

  unless use_default_handles
    if slide_count == 0
      assign slide_count = 6
    endif

    if slide_count > max_products
      assign slide_count = max_products
    endif
  endunless

  if use_default_handles and slide_count > max_products
    assign slide_count = max_products
  endif

  assign carousel_columns = section.settings.columns | default: 3
-%}

<div
  class="edgewater-best-sellers spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="edgewater-best-sellers__inner">
    {%- if section.settings.heading != blank -%}
      <header class="edgewater-best-sellers__header">
        <h2 class="edgewater-best-sellers__heading">{{ section.settings.heading }}</h2>
      </header>
    {%- endif -%}

    <div class="edgewater-best-sellers__carousel">
      {% capture product_slides %}
        {%- if use_default_handles -%}
          {%- for handle in default_handles limit: max_products -%}
            {%- assign product = all_products[handle] -%}
            {%- if product == blank -%}
              {%- continue -%}
            {%- endif -%}
            {% capture product_card %}
              <a href="{{ product.url }}" class="best-seller-card">
                <div class="best-seller-card__media">
                  {%- if product.featured_media != blank -%}
                    {{
                      product.featured_media
                      | image_url: width: 900
                      | image_tag:
                        class: 'best-seller-card__image',
                        alt: product.featured_media.alt | default: product.title,
                        widths: '300, 400, 500, 600, 750, 900',
                        sizes: '(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 85vw',
                        loading: 'lazy'
                    }}
                  {%- else -%}
                    <div class="best-seller-card__placeholder" aria-hidden="true">
                      {{ 'product-apparel-2' | placeholder_svg_tag: 'best-seller-card__placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>

                <h3 class="best-seller-card__title">{{ product.title }}</h3>

                <div class="best-seller-card__price">
                  {%- assign card_variant = product.selected_or_first_available_variant -%}
                  <span class="best-seller-card__price-current">
                    {%- render 'money-product', price: card_variant.price, product_resource: product -%}
                  </span>
                  {%- if card_variant.compare_at_price > card_variant.price -%}
                    <s class="best-seller-card__price-compare">
                      {%- render 'money-product', price: card_variant.compare_at_price, product_resource: product -%}
                    </s>
                  {%- endif -%}
                </div>
              </a>
            {% endcapture %}
            {% render 'slideshow-slide',
              index: forloop.index0,
              children: product_card,
              class: 'best-sellers__slide'
            %}
          {%- endfor -%}
        {%- elsif products != blank and products.size > 0 -%}
          {%- for product in products limit: max_products -%}
            {% capture product_card %}
              <a href="{{ product.url }}" class="best-seller-card">
                <div class="best-seller-card__media">
                  {%- if product.featured_media != blank -%}
                    {{
                      product.featured_media
                      | image_url: width: 900
                      | image_tag:
                        class: 'best-seller-card__image',
                        alt: product.featured_media.alt | default: product.title,
                        widths: '300, 400, 500, 600, 750, 900',
                        sizes: '(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 85vw',
                        loading: 'lazy'
                    }}
                  {%- else -%}
                    <div class="best-seller-card__placeholder" aria-hidden="true">
                      {{ 'product-apparel-2' | placeholder_svg_tag: 'best-seller-card__placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>

                <h3 class="best-seller-card__title">{{ product.title }}</h3>

                <div class="best-seller-card__price">
                  {%- assign card_variant = product.selected_or_first_available_variant -%}
                  <span class="best-seller-card__price-current">
                    {%- render 'money-product', price: card_variant.price, product_resource: product -%}
                  </span>
                  {%- if card_variant.compare_at_price > card_variant.price -%}
                    <s class="best-seller-card__price-compare">
                      {%- render 'money-product', price: card_variant.compare_at_price, product_resource: product -%}
                    </s>
                  {%- endif -%}
                </div>
              </a>
            {% endcapture %}
            {% render 'slideshow-slide',
              index: forloop.index0,
              children: product_card,
              class: 'best-sellers__slide'
            %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            {% capture product_card %}
              <div class="best-seller-card best-seller-card--placeholder">
                <div class="best-seller-card__media">
                  <div class="best-seller-card__placeholder" aria-hidden="true">
                    {{ 'product-apparel-2' | placeholder_svg_tag: 'best-seller-card__placeholder-svg' }}
                  </div>
                </div>
                <h3 class="best-seller-card__title">Product title</h3>
                <div class="best-seller-card__price">
                  <span class="best-seller-card__price-current">$0.00</span>
                </div>
              </div>
            {% endcapture %}
            {% render 'slideshow-slide',
              index: forloop.index0,
              children: product_card,
              class: 'best-sellers__slide'
            %}
          {%- endfor -%}
        {%- endif -%}
      {% endcapture %}

      {% capture carousel_style %}
        --carousel-columns: {{ carousel_columns }};
        --carousel-tablet-columns: 2;
        --carousel-mobile-columns: 1;
        --carousel-gap: 1.5rem;
      {% endcapture %}

      {% render 'slideshow',
        ref: 'edgewaterBestSellers',
        class: 'best-sellers-carousel',
        style: carousel_style,
        slides: product_slides,
        show_arrows: true,
        icon_style: 'chevron',
        icon_shape: 'none',
        auto_hide_controls: false,
        infinite: false,
        initial_slide: 0,
        slide_count: slide_count,
        slide_position: 'stretch',
        arrows_position: 'center'
      %}
    </div>
  </div>
</div>

{% stylesheet %}
  .shopify-section:has(.edgewater-best-sellers) {
    background-color: #fafafc;
  }

  .edgewater-best-sellers {
    width: 100%;
    background-color: transparent;
  }

  .edgewater-best-sellers__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: max(1rem, var(--page-margin, 16px));
  }

  @media screen and (min-width: 750px) {
    .edgewater-best-sellers__inner {
      gap: 2.5rem;
      padding-inline: max(1.5rem, var(--page-margin, 40px));
    }
  }

  .edgewater-best-sellers__header {
    text-align: center;
  }

  .edgewater-best-sellers__heading {
    margin: 0;
    font-family: var(--font-cormorant-garamond--family);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    color: #433625;
  }

  .edgewater-best-sellers__carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .best-sellers-carousel slideshow-container {
    position: relative;
    display: block;
    background-color: transparent;
    padding-inline: 4rem;
  }

  @media screen and (min-width: 768px) {
    .best-sellers-carousel slideshow-container {
      padding-inline: 4.5rem;
    }
  }

  .best-sellers-carousel slideshow-container > slideshow-slides {
    position: relative;
    z-index: 1;
    --slideshow-gap: var(--carousel-gap, 1.5rem);
    align-items: stretch;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  .best-sellers-carousel slideshow-container > slideshow-arrows {
    position: absolute !important;
    inset: 0 !important;
    z-index: 2;
    display: flex !important;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    pointer-events: none;
    mix-blend-mode: normal;
  }

  .best-sellers-carousel slideshow-container > slideshow-arrows .slideshow-control {
    opacity: 1 !important;
    position: static;
    transform: none !important;
    animation: none !important;
    pointer-events: auto;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    min-width: 4rem;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    color: #433625;
  }

  .best-sellers-carousel slideshow-container > slideshow-arrows .slideshow-control:hover,
  .best-sellers-carousel slideshow-container > slideshow-arrows .slideshow-control:focus-visible {
    background: transparent;
    color: #433625;
    opacity: 0.75 !important;
  }

  .best-sellers-carousel slideshow-container > slideshow-arrows .slideshow-control[disabled] {
    opacity: 0.35 !important;
  }

  .best-sellers-carousel slideshow-container > slideshow-arrows .slideshow-control .svg-wrapper {
    width: 1.75rem;
    height: 1.75rem;
  }

  @media screen and (max-width: 767px) {
    .best-sellers-carousel slideshow-container {
      padding-inline: 3.5rem;
    }

    .best-sellers-carousel slideshow-container > slideshow-arrows .slideshow-control {
      min-height: 3.5rem;
      min-width: 3.5rem;
    }

    .best-sellers-carousel slideshow-container > slideshow-arrows .slideshow-control .svg-wrapper {
      width: 1.625rem;
      height: 1.625rem;
    }
  }

  .best-sellers-carousel slideshow-slides > slideshow-slide,
  .best-sellers-carousel slideshow-slides > .best-sellers__slide {
    flex: 0 0 auto;
    height: auto;
    align-self: stretch;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    width: calc(
      (100% - (var(--carousel-gap, 1.5rem) * (var(--carousel-mobile-columns, 1) - 1))) /
        var(--carousel-mobile-columns, 1)
    );
  }

  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .best-sellers-carousel slideshow-slides > slideshow-slide,
    .best-sellers-carousel slideshow-slides > .best-sellers__slide {
      width: calc(
        (100% - (var(--carousel-gap, 1.5rem) * (var(--carousel-tablet-columns, 2) - 1))) /
          var(--carousel-tablet-columns, 2)
      );
    }
  }

  @media screen and (min-width: 1024px) {
    .best-sellers-carousel slideshow-slides > slideshow-slide,
    .best-sellers-carousel slideshow-slides > .best-sellers__slide {
      width: calc(
        (100% - (var(--carousel-gap, 1.5rem) * (var(--carousel-columns, 3) - 1))) /
          var(--carousel-columns, 3)
      );
    }
  }

  .best-seller-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .best-seller-card--placeholder {
    pointer-events: none;
    opacity: 0.65;
  }

  .best-seller-card__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  .best-seller-card__image,
  .best-seller-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .best-seller-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(67 54 37 / 0.04);
    border-radius: 0.5rem;
  }

  .best-seller-card__placeholder-svg {
    width: 55%;
    height: auto;
    opacity: 0.35;
  }

  .best-seller-card__title {
    margin: 0;
    max-width: 16rem;
    font-family: var(--font-body--family);
    font-size: clamp(0.875rem, 1.8vw, 0.9375rem);
    font-weight: 400;
    line-height: 1.35;
    text-align: center;
    color: #433625;
  }

  .best-seller-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    margin-top: auto;
  }

  .best-seller-card__price-current {
    font-size: clamp(0.9375rem, 2vw, 1rem);
    font-weight: 700;
    line-height: 1.2;
    color: #433625;
  }

  .best-seller-card__price-compare {
    font-size: clamp(0.8125rem, 1.6vw, 0.875rem);
    font-weight: 400;
    line-height: 1.2;
    color: rgb(67 54 37 / 0.45);
    text-decoration: line-through;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Edgewater best sellers",
  "class": "section-edgewater-best-sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Best Sellers"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Best seller products",
      "limit": 10
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection",
      "info": "Used when no products are selected above."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Slides per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Edgewater best sellers"
    }
  ]
}
{% endschema %}
