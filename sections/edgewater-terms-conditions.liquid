{{ 'edgewater-terms.css' | asset_url | stylesheet_tag }}
<script src="{{ 'edgewater-terms.js' | asset_url }}" defer></script>

<edgewater-terms
  class="edgewater-terms spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-default-language="{{ section.settings.default_language | default: 'en' }}"
  {{ section.shopify_attributes }}
>
  <div class="edgewater-terms__inner">
    {%- if section.settings.heading != blank -%}
      <header class="edgewater-terms__header">
        <h1 class="edgewater-terms__title">{{ section.settings.heading }}</h1>
      </header>
    {%- endif -%}

    {%- if section.settings.show_language_toggle -%}
      <div class="edgewater-terms__lang-switch" role="tablist" aria-label="Document language">
        <button
          type="button"
          class="edgewater-terms__lang-btn"
          role="tab"
          aria-selected="false"
          data-language="en"
        >
          {{ section.settings.lang_en_label | default: 'English' }}
        </button>
        <button
          type="button"
          class="edgewater-terms__lang-btn"
          role="tab"
          aria-selected="false"
          data-language="fr"
        >
          {{ section.settings.lang_fr_label | default: 'Francais' }}
        </button>
      </div>
    {%- endif -%}

    {%- assign has_blocks = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'terms_section' -%}
        {%- assign has_blocks = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- unless has_blocks -%}
      <div class="edgewater-terms__content edgewater-terms__content--legacy">
        {% render 'edgewater-terms-conditions-content' %}
      </div>
    {%- else -%}
      <div class="edgewater-terms__layout">
        {%- if section.settings.show_table_of_contents -%}
          <aside class="edgewater-terms__toc-wrap" aria-label="Table of contents">
            <div class="edgewater-terms__toc-card">
              <p class="edgewater-terms__toc-heading">{{ section.settings.toc_heading | default: 'On this page' }}</p>
              <nav class="edgewater-terms__toc" data-toc></nav>
            </div>
          </aside>
        {%- endif -%}

        <div class="edgewater-terms__panels">
          {%- assign terms_languages = 'en,fr' | split: ',' -%}
          {%- for language in terms_languages -%}
            {%- liquid
              assign doc_title = section.settings.en_document_title
              assign last_updated = section.settings.en_last_updated
              assign intro = section.settings.en_intro
              assign notice = section.settings.en_notice

              if language == 'fr'
                assign doc_title = section.settings.fr_document_title
                assign last_updated = section.settings.fr_last_updated
                assign intro = section.settings.fr_intro
                assign notice = section.settings.fr_notice
              endif
            -%}

            <div
              class="edgewater-terms__panel"
              data-language-panel="{{ language }}"
              role="tabpanel"
              hidden
            >
              <div class="edgewater-terms__panel-intro">
                {%- if doc_title != blank -%}
                  <h2 class="edgewater-terms__doc-title">{{ doc_title }}</h2>
                {%- endif -%}

                {%- if last_updated != blank -%}
                  <p class="edgewater-terms__updated">{{ last_updated }}</p>
                {%- endif -%}

                {%- if intro != blank -%}
                  <div class="edgewater-terms__intro rte">{{ intro }}</div>
                {%- endif -%}

                {%- if notice != blank -%}
                  <div class="edgewater-terms__notice rte">{{ notice }}</div>
                {%- endif -%}
              </div>

              <div class="edgewater-terms__sections">
                {%- assign section_index = 0 -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'terms_section' and block.settings.language == language -%}
                    {%- assign section_index = section_index | plus: 1 -%}
                    {%- assign item_id = 'terms-' | append: language | append: '-' | append: block.settings.section_number -%}
                    <div {{ block.shopify_attributes }}>
                      {%- render 'edgewater-terms-item',
                        language: language,
                        section_number: block.settings.section_number,
                        title: block.settings.title,
                        content: block.settings.content,
                        item_id: item_id,
                        open_by_default: false
                      -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_contact_cta -%}
        <div class="edgewater-terms__cta">
          {%- if section.settings.cta_heading != blank -%}
            <p class="edgewater-terms__cta-heading">{{ section.settings.cta_heading }}</p>
          {%- endif -%}

          {%- if section.settings.contact_email != blank or section.settings.contact_phone != blank -%}
            <p class="edgewater-terms__cta-text">
              {%- if section.settings.cta_lead_in != blank -%}
                {{ section.settings.cta_lead_in }}
              {%- endif -%}
              {%- if section.settings.contact_email != blank -%}
                <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
              {%- endif -%}
              {%- if section.settings.cta_middle != blank -%}
                {{ section.settings.cta_middle }}
              {%- endif -%}
              {%- if section.settings.contact_phone != blank -%}
                <a href="tel:{{ section.settings.contact_phone | replace: '-', '' | replace: ' ', '' }}">{{ section.settings.contact_phone }}</a>
              {%- endif -%}
              {%- if section.settings.cta_closing != blank -%}
                {{ section.settings.cta_closing }}
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <button type="button" class="edgewater-terms__back-top" data-back-top hidden>
        Back to top
      </button>
    {%- endunless -%}
  </div>
</edgewater-terms>

{% schema %}
{
  "name": "Edgewater terms",
  "class": "section-edgewater-terms",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Terms & Conditions"
    },
    {
      "type": "header",
      "content": "Display options"
    },
    {
      "type": "checkbox",
      "id": "show_language_toggle",
      "label": "Show language toggle",
      "default": true
    },
    {
      "type": "select",
      "id": "default_language",
      "label": "Default language",
      "options": [
        { "value": "en", "label": "English" },
        { "value": "fr", "label": "French" }
      ],
      "default": "en"
    },
    {
      "type": "checkbox",
      "id": "show_table_of_contents",
      "label": "Show table of contents",
      "default": true
    },
    {
      "type": "text",
      "id": "toc_heading",
      "label": "Table of contents heading",
      "default": "On this page"
    },
    {
      "type": "text",
      "id": "lang_en_label",
      "label": "English toggle label",
      "default": "English"
    },
    {
      "type": "text",
      "id": "lang_fr_label",
      "label": "French toggle label",
      "default": "Francais"
    },
    {
      "type": "header",
      "content": "English introduction"
    },
    {
      "type": "text",
      "id": "en_document_title",
      "label": "Document title",
      "default": "Terms and Conditions"
    },
    {
      "type": "text",
      "id": "en_last_updated",
      "label": "Last updated",
      "default": "Last updated: June 17, 2026"
    },
    {
      "type": "richtext",
      "id": "en_intro",
      "label": "Introduction"
    },
    {
      "type": "richtext",
      "id": "en_notice",
      "label": "Important notice"
    },
    {
      "type": "header",
      "content": "French introduction"
    },
    {
      "type": "text",
      "id": "fr_document_title",
      "label": "Document title",
      "default": "Modalites et conditions"
    },
    {
      "type": "text",
      "id": "fr_last_updated",
      "label": "Last updated",
      "default": "Derniere mise a jour : 17 juin 2026"
    },
    {
      "type": "richtext",
      "id": "fr_intro",
      "label": "Introduction"
    },
    {
      "type": "richtext",
      "id": "fr_notice",
      "label": "Important notice"
    },
    {
      "type": "header",
      "content": "Contact callout"
    },
    {
      "type": "checkbox",
      "id": "show_contact_cta",
      "label": "Show contact callout",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Callout heading",
      "default": "Questions about these terms?"
    },
    {
      "type": "text",
      "id": "cta_lead_in",
      "label": "Text before email",
      "default": "Email us at "
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email",
      "default": "hello@edgewaterfurnishings.com"
    },
    {
      "type": "text",
      "id": "cta_middle",
      "label": "Text between email and phone",
      "default": " or call "
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone",
      "default": "403-671-6650"
    },
    {
      "type": "text",
      "id": "cta_closing",
      "label": "Text after phone",
      "default": "."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "terms_section",
      "name": "Terms section",
      "settings": [
        {
          "type": "select",
          "id": "language",
          "label": "Language",
          "options": [
            { "value": "en", "label": "English" },
            { "value": "fr", "label": "French" }
          ],
          "default": "en"
        },
        {
          "type": "text",
          "id": "section_number",
          "label": "Section number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Section title",
          "default": "Section title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Section content",
          "default": "<p>Section content goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Edgewater terms",
      "blocks": [
        {
          "type": "terms_section",
          "settings": {
            "language": "en",
            "section_number": "1",
            "title": "Who We Are and Contact Information",
            "content": "<p>Contact information for questions about these Terms.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
