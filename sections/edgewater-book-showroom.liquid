{%- liquid
  assign form_id = section.id | prepend: 'EdgewaterBookShowroom-'
-%}

<div
  class="edgewater-book-showroom spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="edgewater-book-showroom__inner">
    <header class="edgewater-book-showroom__header">
      {%- if section.settings.heading != blank -%}
        <h1 class="edgewater-book-showroom__title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <p class="edgewater-book-showroom__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    {%- if section.settings.appointment_notice != blank -%}
      <div class="edgewater-book-showroom__notice" role="note">
        <span class="edgewater-book-showroom__notice-icon svg-wrapper" aria-hidden="true">
          {{- 'icon-info.svg' | inline_asset_content -}}
        </span>
        <p class="edgewater-book-showroom__notice-text">{{ section.settings.appointment_notice }}</p>
      </div>
    {%- endif -%}

    <div class="edgewater-book-showroom__details">
      {%- if section.settings.locations_heading != blank -%}
        <h2 class="edgewater-book-showroom__details-heading">{{ section.settings.locations_heading }}</h2>
      {%- endif -%}

      {%- if section.settings.locations != blank -%}
        <div class="edgewater-book-showroom__details-text rte">{{ section.settings.locations }}</div>
      {%- endif -%}

      {%- if section.settings.contact_heading != blank -%}
        <h2 class="edgewater-book-showroom__details-heading">{{ section.settings.contact_heading }}</h2>
      {%- endif -%}

      <div class="edgewater-book-showroom__contact-lines">
        {%- if section.settings.phone != blank -%}
          <p>
            <span class="edgewater-book-showroom__contact-label">{{ section.settings.phone_label }}</span>
            <a href="tel:{{ section.settings.phone | replace: '-', '' | replace: ' ', '' }}">{{ section.settings.phone }}</a>
          </p>
        {%- endif -%}

        {%- if section.settings.email != blank -%}
          <p>
            <span class="edgewater-book-showroom__contact-label">{{ section.settings.email_label }}</span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.address_note != blank -%}
        <p class="edgewater-book-showroom__address-note">{{ section.settings.address_note }}</p>
      {%- endif -%}
    </div>

    <div class="edgewater-book-showroom__form-card">
      {%- if section.settings.form_heading != blank -%}
        <h2 class="edgewater-book-showroom__form-heading">{{ section.settings.form_heading }}</h2>
      {%- endif -%}

      {%- if section.settings.form_intro != blank -%}
        <p class="edgewater-book-showroom__form-intro">{{ section.settings.form_intro }}</p>
      {%- endif -%}

      {%- form 'contact', id: form_id, class: 'edgewater-book-showroom__form' -%}
        <input name="contact[id]" type="hidden" value="{{ form_id }}">
        <input name="contact[tag]" type="hidden" value="Showroom viewing request">

        {%- if form.errors and form.id == form_id -%}
          <div class="edgewater-book-showroom__message edgewater-book-showroom__message--error" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form.id == form_id -%}
          <div class="edgewater-book-showroom__message edgewater-book-showroom__message--success" tabindex="-1" autofocus>
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
            {{ section.settings.success_message }}
          </div>
        {%- endif -%}

        <div class="edgewater-book-showroom__fields">
          <div class="edgewater-book-showroom__field edgewater-book-showroom__field--third">
            <label class="edgewater-book-showroom__label" for="{{ form_id }}-name">Name</label>
            <input
              type="text"
              id="{{ form_id }}-name"
              class="edgewater-book-showroom__input"
              name="contact[name]"
              autocomplete="name"
              placeholder="{{ section.settings.name_placeholder }}"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              required
            >
          </div>

          <div class="edgewater-book-showroom__field edgewater-book-showroom__field--third">
            <label class="edgewater-book-showroom__label" for="{{ form_id }}-email">Email</label>
            <input
              type="email"
              id="{{ form_id }}-email"
              class="edgewater-book-showroom__input"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              placeholder="{{ section.settings.email_placeholder }}"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              required
            >
          </div>

          <div class="edgewater-book-showroom__field edgewater-book-showroom__field--third">
            <label class="edgewater-book-showroom__label" for="{{ form_id }}-phone">Phone</label>
            <input
              type="tel"
              id="{{ form_id }}-phone"
              class="edgewater-book-showroom__input"
              name="contact[phone]"
              autocomplete="tel"
              placeholder="{{ section.settings.phone_placeholder }}"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            >
          </div>

          <div class="edgewater-book-showroom__field edgewater-book-showroom__field--half">
            <label class="edgewater-book-showroom__label" for="{{ form_id }}-date">Preferred date</label>
            <div class="edgewater-date-picker" data-edgewater-date-picker>
              <div class="edgewater-date-picker__input-wrap">
                <input
                  type="text"
                  id="{{ form_id }}-date"
                  class="edgewater-book-showroom__input edgewater-date-picker__display"
                  data-date-display
                  placeholder="{{ section.settings.date_placeholder }}"
                  readonly
                  autocomplete="off"
                >
                <input type="hidden" name="contact[Preferred date]" data-date-value>
                <button
                  type="button"
                  class="edgewater-date-picker__trigger"
                  data-date-trigger
                  aria-label="Open calendar"
                  aria-expanded="false"
                  aria-controls="{{ form_id }}-calendar"
                >
                  <span class="edgewater-date-picker__icon svg-wrapper" aria-hidden="true">
                    {{- 'icon-calendar.svg' | inline_asset_content -}}
                  </span>
                </button>
              </div>

              <div
                id="{{ form_id }}-calendar"
                class="edgewater-date-picker__calendar"
                data-date-calendar
                role="dialog"
                aria-label="Choose a date"
                hidden
              >
                <div class="edgewater-date-picker__header">
                  <button type="button" class="edgewater-date-picker__nav" data-date-prev aria-label="Previous month">
                    <span class="svg-wrapper" aria-hidden="true">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
                  </button>
                  <p class="edgewater-date-picker__month" data-date-month></p>
                  <button type="button" class="edgewater-date-picker__nav" data-date-next aria-label="Next month">
                    <span class="svg-wrapper" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                  </button>
                </div>

                <div class="edgewater-date-picker__weekdays" aria-hidden="true">
                  <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                </div>

                <div class="edgewater-date-picker__grid" data-date-grid></div>

                <div class="edgewater-date-picker__footer">
                  <button type="button" class="edgewater-date-picker__action" data-date-clear>Clear</button>
                  <button type="button" class="edgewater-date-picker__action" data-date-today>Today</button>
                </div>
              </div>
            </div>
          </div>

          <div class="edgewater-book-showroom__field edgewater-book-showroom__field--half">
            <label class="edgewater-book-showroom__label" for="{{ form_id }}-time">Preferred time</label>
            <div class="edgewater-time-picker" data-edgewater-time-picker>
              <div class="edgewater-time-picker__input-wrap">
                <input
                  type="text"
                  id="{{ form_id }}-time"
                  class="edgewater-book-showroom__input edgewater-time-picker__display"
                  data-time-display
                  placeholder="{{ section.settings.time_placeholder }}"
                  readonly
                  autocomplete="off"
                >
                <input type="hidden" name="contact[Preferred time]" data-time-value>
                <button
                  type="button"
                  class="edgewater-time-picker__trigger"
                  data-time-trigger
                  aria-label="Open time options"
                  aria-expanded="false"
                  aria-controls="{{ form_id }}-time-menu"
                >
                  <span class="edgewater-time-picker__icon svg-wrapper" aria-hidden="true">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </button>
              </div>

              <ul
                id="{{ form_id }}-time-menu"
                class="edgewater-time-picker__menu"
                data-time-menu
                role="listbox"
                aria-label="Preferred time options"
                hidden
              >
                <li>
                  <button type="button" class="edgewater-time-picker__option" data-time-option="Morning (9am – 12pm)">
                    Morning (9am – 12pm)
                  </button>
                </li>
                <li>
                  <button type="button" class="edgewater-time-picker__option" data-time-option="Afternoon (12pm – 4pm)">
                    Afternoon (12pm – 4pm)
                  </button>
                </li>
                <li>
                  <button type="button" class="edgewater-time-picker__option" data-time-option="Evening (4pm – 7pm)">
                    Evening (4pm – 7pm)
                  </button>
                </li>
              </ul>
            </div>
          </div>

          <div class="edgewater-book-showroom__field edgewater-book-showroom__field--full">
            <label class="edgewater-book-showroom__label" for="{{ form_id }}-message">Message</label>
            <textarea
              id="{{ form_id }}-message"
              class="edgewater-book-showroom__input edgewater-book-showroom__textarea"
              name="contact[body]"
              rows="5"
              placeholder="{{ section.settings.message_placeholder }}"
            >{{- form.body -}}</textarea>
          </div>
        </div>

        <div class="edgewater-book-showroom__submit-wrap">
          <button type="submit" class="edgewater-book-showroom__submit">
            {{ section.settings.submit_label }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

<script src="{{ 'edgewater-date-picker.js' | asset_url }}" defer></script>
<script src="{{ 'edgewater-time-picker.js' | asset_url }}" defer></script>

{% stylesheet %}
  .shopify-section:has(.edgewater-book-showroom),
  .shopify-section:has(.edgewater-book-showroom) .section-background {
    background-color: #f3f0ec;
  }

  .edgewater-book-showroom {
    width: 100%;
    background-color: #f3f0ec;
  }

  .edgewater-book-showroom__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.75rem, 3vw, 2.5rem);
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: max(1rem, var(--page-margin, 16px));
  }

  .edgewater-book-showroom__header,
  .edgewater-book-showroom__details {
    width: 100%;
    text-align: center;
  }

  .edgewater-book-showroom__title {
    margin: 0 0 1rem;
    font-family: var(--font-cormorant-garamond--family);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    color: #403730;
  }

  .edgewater-book-showroom__intro,
  .edgewater-book-showroom__details-text,
  .edgewater-book-showroom__contact-lines,
  .edgewater-book-showroom__form-intro {
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #74675d;
  }

  .edgewater-book-showroom__intro {
    margin: 0;
    max-width: 42rem;
    margin-inline: auto;
  }

  .edgewater-book-showroom__notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    max-width: 42rem;
    padding: 0.875rem 1.25rem;
    border-radius: 0.375rem;
    background: #fbf9f7;
    border: 1px solid #ddd7d0;
  }

  .edgewater-book-showroom__notice-icon {
    width: 1.125rem;
    height: 1.125rem;
    color: #8a6d5b;
    flex-shrink: 0;
  }

  .edgewater-book-showroom__notice-text {
    margin: 0;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: #403730;
  }

  .edgewater-book-showroom__details-heading {
    margin: 1.5rem 0 0.5rem;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8a6d5b;
  }

  .edgewater-book-showroom__details-heading:first-child {
    margin-top: 0;
  }

  .edgewater-book-showroom__details-text > *:first-child {
    margin-top: 0;
  }

  .edgewater-book-showroom__details-text > *:last-child {
    margin-bottom: 0;
  }

  .edgewater-book-showroom__contact-lines {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .edgewater-book-showroom__contact-lines p {
    margin: 0;
  }

  .edgewater-book-showroom__contact-lines a {
    color: inherit;
    text-decoration: none;
  }

  .edgewater-book-showroom__contact-lines a:hover,
  .edgewater-book-showroom__contact-lines a:focus-visible {
    color: #403730;
    text-decoration: underline;
  }

  .edgewater-book-showroom__address-note {
    margin: 1rem 0 0;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8125rem;
    font-style: italic;
    line-height: 1.5;
    color: #74675d;
  }

  .edgewater-book-showroom__form-card {
    width: 100%;
    max-width: 52rem;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    border-radius: 0.5rem;
    background: #fbf9f7;
    border: 1px solid #ddd7d0;
  }

  .edgewater-book-showroom__form-heading {
    margin: 0 0 0.5rem;
    text-align: center;
    font-family: var(--font-cormorant-garamond--family);
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-weight: 400;
    line-height: 1.2;
    color: #403730;
  }

  .edgewater-book-showroom__form-intro {
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .edgewater-book-showroom__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .edgewater-book-showroom__message {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
  }

  .edgewater-book-showroom__fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.125rem;
  }

  @media screen and (min-width: 750px) {
    .edgewater-book-showroom__fields {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1rem 1.125rem;
    }

    .edgewater-book-showroom__field--third {
      grid-column: span 2;
    }

    .edgewater-book-showroom__field--half {
      grid-column: span 3;
    }

    .edgewater-book-showroom__field--full {
      grid-column: 1 / -1;
    }
  }

  .edgewater-book-showroom__label {
    display: block;
    margin-bottom: 0.375rem;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #403730;
  }

  .edgewater-book-showroom__input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid #ddd7d0;
    border-radius: 0.25rem;
    background: #fff;
    color: #403730;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .edgewater-book-showroom__input::placeholder {
    color: rgb(116 103 93 / 0.65);
  }

  .edgewater-book-showroom__input:focus-visible {
    outline: 2px solid #8a6d5b;
    outline-offset: 1px;
  }

  .edgewater-book-showroom__textarea {
    resize: vertical;
    min-height: 7.5rem;
  }

  .edgewater-date-picker,
  .edgewater-time-picker {
    position: relative;
    width: 100%;
  }

  .edgewater-date-picker__input-wrap,
  .edgewater-time-picker__input-wrap {
    position: relative;
  }

  .edgewater-date-picker__display,
  .edgewater-time-picker__display {
    padding-right: 2.75rem;
    cursor: pointer;
  }

  .edgewater-date-picker__trigger,
  .edgewater-time-picker__trigger {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: transparent;
    color: #74675d;
    transform: translateY(-50%);
    cursor: pointer;
  }

  .edgewater-date-picker__trigger:hover,
  .edgewater-date-picker__trigger:focus-visible,
  .edgewater-time-picker__trigger:hover,
  .edgewater-time-picker__trigger:focus-visible {
    color: #403730;
  }

  .edgewater-date-picker__icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .edgewater-time-picker__icon {
    width: 0.8rem;
    height: 0.8rem;
  }

  .edgewater-date-picker__calendar {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.5rem);
    left: 0;
    width: min(100%, 18.5rem);
    padding: 0.875rem;
    border: 1px solid #ddd7d0;
    border-radius: 0.5rem;
    background: #fff;
    box-shadow: 0 12px 28px rgb(47 39 34 / 0.12);
  }

  .edgewater-date-picker__header {
    display: grid;
    grid-template-columns: 2rem 1fr 2rem;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .edgewater-date-picker__month {
    margin: 0;
    text-align: center;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #403730;
  }

  .edgewater-date-picker__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid #ddd7d0;
    border-radius: 0.25rem;
    background: #fbf9f7;
    color: #74675d;
    cursor: pointer;
  }

  .edgewater-date-picker__nav:hover,
  .edgewater-date-picker__nav:focus-visible {
    color: #403730;
    border-color: #8a6d5b;
  }

  .edgewater-date-picker__nav .svg-wrapper {
    width: 0.75rem;
    height: 0.75rem;
  }

  .edgewater-date-picker__weekdays,
  .edgewater-date-picker__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.2rem;
  }

  .edgewater-date-picker__weekdays {
    margin-bottom: 0.35rem;
  }

  .edgewater-date-picker__weekdays span {
    text-align: center;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #8a6d5b;
  }

  .edgewater-date-picker__day {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0.25rem;
    background: transparent;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8125rem;
    color: #403730;
    cursor: pointer;
  }

  .edgewater-date-picker__day:hover:not(:disabled),
  .edgewater-date-picker__day:focus-visible:not(:disabled) {
    background: #f3f0ec;
    border-color: #ddd7d0;
  }

  .edgewater-date-picker__day--today:not(.edgewater-date-picker__day--selected) {
    border-color: #8a6d5b;
  }

  .edgewater-date-picker__day--selected {
    background: #2f2722;
    border-color: #2f2722;
    color: #fff;
  }

  .edgewater-date-picker__day--disabled,
  .edgewater-date-picker__day--empty {
    cursor: default;
  }

  .edgewater-date-picker__day--disabled {
    color: rgb(116 103 93 / 0.35);
  }

  .edgewater-date-picker__footer {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #ece7e1;
  }

  .edgewater-date-picker__action {
    padding: 0;
    border: none;
    background: transparent;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #8a6d5b;
    cursor: pointer;
  }

  .edgewater-date-picker__action:hover,
  .edgewater-date-picker__action:focus-visible {
    color: #403730;
    text-decoration: underline;
  }

  .edgewater-time-picker__menu {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.5rem);
    left: 0;
    width: 100%;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    border: 1px solid #ddd7d0;
    border-radius: 0.5rem;
    background: #fff;
    box-shadow: 0 12px 28px rgb(47 39 34 / 0.12);
  }

  .edgewater-time-picker__option {
    display: block;
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: none;
    border-radius: 0.25rem;
    background: transparent;
    text-align: left;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
    color: #403730;
    cursor: pointer;
  }

  .edgewater-time-picker__option:hover,
  .edgewater-time-picker__option:focus-visible {
    background: #f3f0ec;
  }

  .edgewater-time-picker__option--selected {
    background: #2f2722;
    color: #fff;
  }

  .edgewater-time-picker__option--selected:hover,
  .edgewater-time-picker__option--selected:focus-visible {
    background: #403730;
    color: #fff;
  }

  .edgewater-book-showroom__submit-wrap {
    display: flex;
    justify-content: center;
    padding-top: 0.25rem;
  }

  .edgewater-book-showroom__submit {
    min-width: 10rem;
    padding: 0.9rem 2rem;
    border: none;
    border-radius: 0.25rem;
    background: #2f2722;
    color: #fff;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .edgewater-book-showroom__submit:hover,
  .edgewater-book-showroom__submit:focus-visible {
    background: #403730;
  }
{% endstylesheet %}

