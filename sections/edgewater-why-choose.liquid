{%- liquid
  assign reviews_link = section.settings.reviews_link
  if reviews_link == blank
    assign reviews_link = routes.root_url | append: '#reviews'
  endif
-%}

<div
  class="edgewater-why-choose spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="edgewater-why-choose__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="edgewater-why-choose__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="edgewater-why-choose__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign icon_asset = ''
            case block.settings.icon
              when 'alberta_family_owned'
                assign icon_asset = 'edgewater-why-choose-alberta-family-owned.png'
              when 'premium_comfort'
                assign icon_asset = 'edgewater-why-choose-premium-comfort.png'
              when 'performance_fabrics'
                assign icon_asset = 'edgewater-why-choose-performance-fabrics.png'
              when 'white_glove_delivery'
                assign icon_asset = 'edgewater-why-choose-white-glove-delivery.png'
              when 'happy_customers'
                assign icon_asset = 'edgewater-why-choose-happy-customers.png'
            endcase
          -%}

          <li
            class="edgewater-why-choose__item"
            {{ block.shopify_attributes }}
          >
            <div class="edgewater-why-choose__icon-wrap">
              {%- if block.settings.custom_icon != blank -%}
                {{
                  block.settings.custom_icon
                  | image_url: width: 240
                  | image_tag:
                    class: 'edgewater-why-choose__icon edgewater-why-choose__icon--image',
                    alt: '',
                    widths: '120, 160, 200, 240',
                    sizes: '120px',
                    loading: 'lazy'
                }}
              {%- elsif icon_asset != blank -%}
                <img
                  class="edgewater-why-choose__icon edgewater-why-choose__icon--image"
                  src="{{ icon_asset | asset_url }}"
                  alt=""
                  width="120"
                  height="120"
                  loading="lazy"
                >
              {%- endif -%}
            </div>

            <div class="edgewater-why-choose__label">
              {%- if block.settings.show_reviews_link -%}
                <p>
                  {{- block.settings.label_prefix -}}
                  <a href="{{ reviews_link }}" class="edgewater-why-choose__reviews-link">
                    <strong>{{ block.settings.reviews_link_text }}</strong>
                  </a>
                </p>
              {%- elsif block.settings.label != blank -%}
                <p>{{ block.settings.label }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .shopify-section:has(.edgewater-why-choose),
  .shopify-section:has(.edgewater-why-choose) .section-background {
    background-color: #f4f0ec;
  }

  .edgewater-why-choose {
    width: 100%;
    background-color: #f4f0ec;
  }

  .edgewater-why-choose__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2rem, 4vw, 3rem);
    padding-inline: max(1rem, var(--page-margin, 16px));
  }

  .edgewater-why-choose__heading {
    margin: 0;
    max-width: 36rem;
    text-align: center;
    font-family: var(--font-cormorant-garamond--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    color: #433a34;
  }

  .edgewater-why-choose__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1rem, 2.5vw, 1.75rem);
    width: 100%;
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .edgewater-why-choose__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(100%, 13rem);
  }

  @media screen and (min-width: 750px) {
    .edgewater-why-choose__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      max-width: 76rem;
      gap: clamp(2rem, 3vw, 3rem) clamp(1.25rem, 2vw, 2rem);
    }

    .edgewater-why-choose__item:last-child:nth-child(odd) {
      grid-column: auto;
      justify-self: stretch;
      width: auto;
    }

    .edgewater-why-choose__item:nth-child(1) {
      grid-column: 1 / 3;
    }

    .edgewater-why-choose__item:nth-child(2) {
      grid-column: 3 / 5;
    }

    .edgewater-why-choose__item:nth-child(3) {
      grid-column: 5 / 7;
    }

    .edgewater-why-choose__item:nth-child(4) {
      grid-column: 2 / 4;
    }

    .edgewater-why-choose__item:nth-child(5) {
      grid-column: 4 / 6;
    }
  }

  .edgewater-why-choose__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .edgewater-why-choose__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6.5rem;
    height: 6.5rem;
  }

  @media screen and (min-width: 750px) {
    .edgewater-why-choose__icon-wrap {
      width: 7.5rem;
      height: 7.5rem;
    }
  }

  .edgewater-why-choose__icon--image {
    width: 5.5rem;
    height: 5.5rem;
    object-fit: contain;
  }

  @media screen and (min-width: 750px) {
    .edgewater-why-choose__icon--image {
      width: 6.5rem;
      height: 6.5rem;
    }
  }

  .edgewater-why-choose__label {
    max-width: 13rem;
    font-family: Montserrat, 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.45;
    color: #433a34;
  }

  @media screen and (min-width: 750px) {
    .edgewater-why-choose__label {
      font-size: 0.9375rem;
    }
  }

  .edgewater-why-choose__label p {
    margin: 0;
    font-weight: 600;
  }

  .edgewater-why-choose__reviews-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .edgewater-why-choose__reviews-link:hover,
  .edgewater-why-choose__reviews-link:focus-visible {
    color: #433a34;
  }

  .edgewater-why-choose__reviews-link strong {
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Edgewater why choose",
  "class": "section-edgewater-why-choose",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Edgewater?"
    },
    {
      "type": "url",
      "id": "reviews_link",
      "label": "Reviews link",
      "info": "Used for the Happy customers benefit. Defaults to the homepage Reviews section."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "alberta_family_owned", "label": "Alberta-based, family-owned" },
            { "value": "premium_comfort", "label": "Premium comfort without markups" },
            { "value": "performance_fabrics", "label": "Performance fabrics" },
            { "value": "white_glove_delivery", "label": "White glove delivery & assembly" },
            { "value": "happy_customers", "label": "Happy local customers" }
          ],
          "default": "alberta_family_owned"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional. Overrides the selected icon when set."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Benefit"
        },
        {
          "type": "checkbox",
          "id": "show_reviews_link",
          "label": "Show reviews link",
          "default": false
        },
        {
          "type": "text",
          "id": "label_prefix",
          "label": "Label prefix",
          "default": "Hundreds of happy local customers with ",
          "visible_if": "{{ block.settings.show_reviews_link }}"
        },
        {
          "type": "text",
          "id": "reviews_link_text",
          "label": "Reviews link text",
          "default": "5-star reviews",
          "visible_if": "{{ block.settings.show_reviews_link }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Edgewater why choose",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "alberta_family_owned",
            "label": "Alberta-Based, Family-Owned"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "premium_comfort",
            "label": "Premium Comfort Without the Markups"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "performance_fabrics",
            "label": "Performance Fabrics for Everyday Life"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "white_glove_delivery",
            "label": "White Glove Delivery & Assembly"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "happy_customers",
            "show_reviews_link": true,
            "label_prefix": "Hundreds of happy local customers with ",
            "reviews_link_text": "5-star reviews"
          }
        }
      ]
    }
  ]
}
{% endschema %}
