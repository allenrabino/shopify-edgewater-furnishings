
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} customer-reviews spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="customer-reviews__inner page-width">
    <header class="customer-reviews__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="customer-reviews__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="customer-reviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.show_summary -%}
        <div class="customer-reviews__summary">
          <div class="customer-reviews__summary-rating-row">
            <div class="customer-reviews__summary-stars" aria-hidden="true">
              {%- assign summary_rating = section.settings.summary_rating | round -%}
              {%- for i in (1..5) -%}
                <span class="customer-reviews__summary-star{% if i <= summary_rating %} customer-reviews__summary-star--filled{% endif %}">★</span>
              {%- endfor -%}
            </div>
            <p class="customer-reviews__summary-text">
              <span class="customer-reviews__summary-rating">{{ section.settings.summary_rating }}</span>
              {%- if section.settings.review_count > 0 -%}
                <span class="customer-reviews__summary-count">({{ section.settings.review_count }} reviews)</span>
              {%- endif -%}
            </p>
          </div>
          {%- if section.settings.source_label != blank -%}
            <p class="customer-reviews__summary-source">{{ section.settings.source_label }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="customer-reviews__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </header>

    <div
      class="customer-reviews__grid"
      style="--review-columns: {{ section.settings.columns }};"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .customer-reviews__inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl);
  }

  .customer-reviews__header {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }

  .customer-reviews__eyebrow {
    margin: 0 0 var(--gap-sm);
    font-size: var(--font-size--xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .customer-reviews__heading {
    margin: 0 0 var(--gap-md);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .customer-reviews__summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs);
    margin-bottom: var(--gap-md);
  }

  .customer-reviews__summary-rating-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.5rem;
  }

  .customer-reviews__summary-stars {
    display: flex;
    gap: 0.2rem;
    font-size: 1.25rem;
    line-height: 1;
  }

  .customer-reviews__summary-star {
    color: rgb(var(--announcement-bar-color-rgb) / 0.25);
  }

  .customer-reviews__summary-star--filled {
    color: var(--announcement-bar-color);
  }

  .customer-reviews__summary-text {
    margin: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.35rem;
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    white-space: nowrap;
  }

  .customer-reviews__summary-rating {
    font-weight: 600;
    color: var(--color-foreground);
  }

  .customer-reviews__summary-source {
    margin: 0;
    width: 100%;
    text-align: center;
    font-size: var(--font-size--xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .customer-reviews__description {
    font-size: var(--font-size--md);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    line-height: 1.6;
  }

  .shopify-section:has(.customer-reviews),
  .shopify-section:has(.customer-reviews) .section-background {
    background-color: #f4efe8;
  }

  .customer-reviews {
    background-color: transparent;
  }

  .customer-reviews__grid {
    display: grid;
    grid-template-columns: repeat(var(--review-columns, 3), minmax(0, 1fr));
    gap: var(--gap-xl);
    align-items: stretch;
  }

  @media screen and (min-width: 1000px) {
    .customer-reviews__grid {
      grid-template-rows: auto auto 1fr auto auto;
      column-gap: var(--gap-xl);
      row-gap: var(--gap-xs);
      justify-items: center;
    }
  }

  @media screen and (max-width: 999px) {
    .customer-reviews__grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .customer-reviews__grid .customer-review {
      width: min(100%, 22rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer reviews",
  "class": "ui-test-customer-reviews",
  "blocks": [
    {
      "type": "_customer-review"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "header",
      "content": "Summary"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show rating summary",
      "default": true
    },
    {
      "type": "range",
      "id": "summary_rating",
      "label": "Average rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 5
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Total review count",
      "default": 98
    },
    {
      "type": "text",
      "id": "source_label",
      "label": "Source label",
      "default": "Facebook Marketplace reviews",
      "info": "Shown under the rating — does not link externally unless you add a link in the description."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        {
          "type": "_customer-review"
        },
        {
          "type": "_customer-review"
        },
        {
          "type": "_customer-review"
        }
      ]
    }
  ]
}
{% endschema %}
