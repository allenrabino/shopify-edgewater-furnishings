{%- liquid
  assign panel_min_height = section.settings.panel_min_height | default: 28
-%}

<div
  class="edgewater-split-image spacing-style"
  style="{% render 'spacing-style', settings: section.settings %} --split-panel-min-height: {{ panel_min_height }}rem;"
  {{ section.shopify_attributes }}
>
  <div class="edgewater-split-image__grid">
    <article class="edgewater-split-image__panel">
      <div class="edgewater-split-image__media">
        {%- if section.settings.left_image != blank -%}
          {{
            section.settings.left_image
            | image_url: width: 2400
            | image_tag:
              class: 'edgewater-split-image__image',
              alt: section.settings.left_heading,
              widths: '750, 960, 1200, 1600, 1920, 2400',
              sizes: '(min-width: 768px) 50vw, 100vw',
              loading: 'lazy'
          }}
        {%- else -%}
          <div class="edgewater-split-image__placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      <div class="edgewater-split-image__overlay" aria-hidden="true"></div>
      <div class="edgewater-split-image__content">
        {%- if section.settings.left_heading != blank -%}
          <h2 class="edgewater-split-image__heading">{{ section.settings.left_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.left_text != blank -%}
          <p class="edgewater-split-image__text">{{ section.settings.left_text }}</p>
        {%- endif -%}
      </div>
    </article>

    <article class="edgewater-split-image__panel">
      <div class="edgewater-split-image__media">
        {%- if section.settings.right_image != blank -%}
          {{
            section.settings.right_image
            | image_url: width: 2400
            | image_tag:
              class: 'edgewater-split-image__image',
              alt: section.settings.right_heading,
              widths: '750, 960, 1200, 1600, 1920, 2400',
              sizes: '(min-width: 768px) 50vw, 100vw',
              loading: 'lazy'
          }}
        {%- else -%}
          <div class="edgewater-split-image__placeholder edgewater-split-image__placeholder--alt" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      <div class="edgewater-split-image__overlay" aria-hidden="true"></div>
      <div class="edgewater-split-image__content">
        {%- if section.settings.right_heading != blank -%}
          <h2 class="edgewater-split-image__heading">{{ section.settings.right_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.right_text != blank -%}
          <p class="edgewater-split-image__text">{{ section.settings.right_text }}</p>
        {%- endif -%}
      </div>
    </article>
  </div>
</div>

{% stylesheet %}
  .edgewater-split-image {
    width: 100%;
  }

  .edgewater-split-image__grid {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    .edgewater-split-image__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .edgewater-split-image__panel {
    position: relative;
    display: grid;
    min-height: var(--split-panel-min-height, 28rem);
    overflow: hidden;
    isolation: isolate;
  }

  @media screen and (min-width: 768px) {
    .edgewater-split-image__panel {
      min-height: calc(var(--split-panel-min-height, 28rem) * 1.15);
    }
  }

  .edgewater-split-image__media,
  .edgewater-split-image__overlay,
  .edgewater-split-image__content {
    grid-area: 1 / 1;
  }

  .edgewater-split-image__media {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  .edgewater-split-image__image,
  .edgewater-split-image__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: center;
  }

  .edgewater-split-image__placeholder {
    background:
      linear-gradient(135deg, rgb(67 54 37 / 0.18), rgb(67 54 37 / 0.05)),
      #d8d0c8;
  }

  .edgewater-split-image__placeholder--alt {
    background:
      linear-gradient(135deg, rgb(67 54 37 / 0.12), rgb(67 54 37 / 0.04)),
      #cfc6bc;
  }

  .edgewater-split-image__overlay {
    z-index: 1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72) 0%, rgb(0 0 0 / 0.35) 42%, rgb(0 0 0 / 0.08) 100%);
  }

  .edgewater-split-image__content {
    z-index: 2;
    align-self: end;
    justify-self: start;
    width: 100%;
    max-width: 34rem;
    padding: 1.5rem;
    color: #fff;
  }

  @media screen and (min-width: 768px) {
    .edgewater-split-image__content {
      padding: 2rem 2.25rem;
    }
  }

  @media screen and (min-width: 1024px) {
    .edgewater-split-image__content {
      padding: 2.5rem 2.75rem;
    }
  }

  .edgewater-split-image__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-cormorant-garamond--family);
    font-size: clamp(1.625rem, 3vw, 2.375rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: #fff;
  }

  .edgewater-split-image__text {
    margin: 0;
    max-width: 30rem;
    font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.92);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Edgewater split image",
  "class": "section-edgewater-split-image",
  "settings": [
    {
      "type": "header",
      "content": "Left panel"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "left_heading",
      "label": "Left heading",
      "default": "Performance Fabrics for Everyday Life"
    },
    {
      "type": "textarea",
      "id": "left_text",
      "label": "Left text",
      "default": "Liquid-repelling, stain-resistant fabrics designed to handle everyday spills, family movie nights, kids, pets, and busy homes"
    },
    {
      "type": "header",
      "content": "Right panel"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Right heading",
      "default": "White Glove Delivery"
    },
    {
      "type": "textarea",
      "id": "right_text",
      "label": "Right text",
      "default": "Our local White Glove Delivery service includes delivery, assembly in your space, and packaging removal. You just open the door - we'll take care of the rest."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "panel_min_height",
      "label": "Panel minimum height",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "rem",
      "default": 28
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Edgewater split image"
    }
  ]
}
{% endschema %}
