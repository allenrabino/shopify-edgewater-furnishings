{%- doc -%}
  Compact shop logo for the mobile menu drawer.

  @param {number} [logo_height] - Logo height in pixels (default 52)
{%- enddoc -%}

{%- liquid
  assign drawer_logo_height = logo_height | default: 52
  assign logo_aspect = settings.logo.aspect_ratio | default: 1.5
  assign drawer_logo_width = drawer_logo_height | times: logo_aspect | ceil
-%}

<a
  href="{{ routes.root_url }}"
  class="menu-drawer__logo"
  aria-label="{{ shop.name | escape }}"
>
  {%- if settings.logo != blank -%}
    {{
      settings.logo
      | image_url: width: 480
      | image_tag:
        class: 'menu-drawer__logo-image',
        widths: '120, 180, 240, 360, 480',
        sizes: '(max-width: 749px) 140px, 160px',
        height: drawer_logo_height,
        width: drawer_logo_width,
        alt: shop.name,
        loading: 'lazy'
    }}
  {%- else -%}
    <span class="menu-drawer__logo-text">{{ shop.name }}</span>
  {%- endif -%}
</a>
