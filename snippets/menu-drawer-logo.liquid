{%- doc -%}
  Compact shop logo for the mobile menu drawer.

  @param {number} [logo_height] - Logo height in pixels (default 52)
{%- enddoc -%}

{%- liquid
  assign drawer_logo_height = logo_height | default: 52
-%}

<a
  href="{{ routes.root_url }}"
  class="menu-drawer__logo"
  aria-label="{{ shop.name | escape }}"
>
  {%- render 'edgewater-logo-image',
    variant: 'light-bg',
    class: 'menu-drawer__logo-image',
    height: drawer_logo_height,
    loading: 'lazy'
  -%}
</a>
