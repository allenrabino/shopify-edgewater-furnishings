{%- doc -%}
  Returns the default fabric key for the product gallery and fabric picker.

  @param {object} product - Product object
{%- enddoc -%}

{%- liquid
  assign default_key = ''
  assign selected_variant = product.selected_or_first_available_variant

  if selected_variant != blank and product.has_only_default_variant == false
    capture default_key
      render 'fabric-key-from-variant', variant: selected_variant, product: product
    endcapture
    assign default_key = default_key | strip | downcase
  endif

  assign fabrics = product.metafields.custom.fabric_colors.value

  if fabrics != blank and fabrics.size > 0
    assign first_fabric = fabrics[0]
    assign default_key = first_fabric.fabric_key.value | default: first_fabric.fabric_key | strip | downcase
    if default_key == blank
      assign first_color_name = first_fabric.color_name.value | default: first_fabric.color_name | strip
      if first_color_name != blank
        assign default_key = first_color_name | handleize
      endif
    endif
  endif

  if default_key == blank
    for media in product.media
      capture media_fabric_key
        render 'resolve-media-fabric-key', media: media, product: product
      endcapture
      assign media_fabric_key = media_fabric_key | strip
      if media_fabric_key != blank
        assign default_key = media_fabric_key
        break
      endif
    endfor
  endif
-%}
{{- default_key -}}
