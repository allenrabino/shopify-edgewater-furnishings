{%- doc -%}
  Collapsible product configuration step (e.g. fabric picker, add a piece).

  @param {string} heading - Step title in the summary row
  @param {string} [heading_with_fabric] - Title when a fabric step is shown above (use with heading_without_fabric)
  @param {string} [heading_without_fabric] - Title when no fabric step is shown above
  @param {string} content - HTML for the expandable body (pass via capture)
  @param {boolean} [open_by_default] - Start expanded when true
  @param {string} [disclosure_id] - Unique suffix for summary id / a11y
  @param {string} [class] - Extra class on the accordion-custom wrapper
{%- enddoc -%}

{%- liquid
  assign open_by_default = open_by_default | default: true, allow_false: true
  assign disclosure_id = disclosure_id | default: 'step'
  assign wrapper_class = class | default: ''
  assign use_dual_headings = false
  if heading_with_fabric != blank and heading_without_fabric != blank
    assign use_dual_headings = true
  endif
-%}

<accordion-custom
  class="product-step-disclosure accordion--caret {{ wrapper_class }}"
  {% if open_by_default %}
    open-by-default-on-desktop
    open-by-default-on-mobile
  {% endif %}
>
  <details
    class="details product-step-disclosure__details"
    {% if open_by_default %}
      open
    {% endif %}
  >
    <summary
      class="details__header product-step-disclosure__summary"
      id="product-step-summary-{{ disclosure_id }}"
    >
      {% if use_dual_headings %}
        <span class="product-step-disclosure__heading product-step-disclosure__heading--dual">
          <span class="product-step-disclosure__heading-when-fabric">{{ heading_with_fabric }}</span>
          <span class="product-step-disclosure__heading-no-fabric">{{ heading_without_fabric }}</span>
        </span>
      {% else %}
        <span class="product-step-disclosure__heading">{{ heading }}</span>
      {% endif %}
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper icon-plus">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="details-content product-step-disclosure__content">
      {{ content }}
    </div>
  </details>
</accordion-custom>

{% stylesheet %}
  .product-step-disclosure {
    width: 100%;
  }

  .product-step-disclosure.accordion--caret .icon-plus {
    display: none;
  }

  .product-step-disclosure__details {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .product-step-disclosure__summary {
    font-size: var(--font-size--md);
    font-weight: 600;
    padding-block: var(--padding-md);
  }

  .product-step-disclosure__heading--dual {
    display: inline;
  }

  .product-step-disclosure__heading-when-fabric,
  .product-step-disclosure__heading-no-fabric {
    display: inline;
  }

  .product-step-disclosure__heading {
    flex: 1;
    text-align: start;
  }

  .product-step-disclosure__content {
    padding-block-start: var(--gap-lg);
    padding-block-end: var(--padding-md);
  }

  /* Stable layout when folding — hide swatches cleanly, no overflow bleed */
  accordion-custom.product-step-disclosure {
    display: block;
    width: 100%;
  }

  accordion-custom.product-step-disclosure .product-step-disclosure__details {
    overflow: hidden;
  }

  accordion-custom.product-step-disclosure details:not([open]) .product-step-disclosure__content {
    overflow: hidden;
    padding-block: 0;
    margin: 0;
    visibility: hidden;
  }

  /* Keep swatch selection rings visible only while open */
  accordion-custom.product-step-disclosure details[open] .product-step-disclosure__content {
    overflow: visible;
    visibility: visible;
  }

  @media screen and (max-width: 749px) {
    accordion-custom.variant-picker__fabric-disclosure.product-step-disclosure .product-step-disclosure__details {
      overflow-x: clip;
      overflow-y: visible;
      min-width: 0;
    }

    accordion-custom.variant-picker__fabric-disclosure.product-step-disclosure details[open] .product-step-disclosure__content {
      overflow-x: clip;
      overflow-y: visible;
      min-width: 0;
    }
  }
{% endstylesheet %}
