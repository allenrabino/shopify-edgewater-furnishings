{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
{%- enddoc -%}

{% if block == blank %}
  {% assign block_settings = nil %}
{% else %}
  {% assign block_settings = block.settings %}
{% endif %}

{% unless product_resource.has_only_default_variant or block == blank %}
  {% liquid
    assign button_background_brightness = section.settings.color_scheme.settings.foreground | color_brightness
    if button_background_brightness < 105
      assign strikethrough_color_mix = '#000'
    else
      assign strikethrough_color_mix = '#fff'
    endif
  %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}"
    style="--color-strikethrough-mix: {{ strikethrough_color_mix }}; {% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- liquid
          assign option_name_downcase = product_option.name | downcase
          assign is_fabric_option = false
          if option_name_downcase contains 'fabric' or option_name_downcase contains 'color' or option_name_downcase contains 'colour' or option_name_downcase contains 'material'
            assign is_fabric_option = true
          endif
          assign option_variant_style = variant_style
          if is_fabric_option
            assign option_variant_style = 'swatch'
          endif
        -%}
        {%- if option_variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          {%- assign fieldset_index = forloop.index0 -%}
          {%- capture fieldset_markup -%}
          <fieldset
            class="variant-option variant-option--buttons{% if option_variant_style == 'swatch' %} variant-option--swatches{% if is_fabric_option %} variant-option--fabric-grid{% endif %}{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            {% if is_fabric_option %}data-fabric-option="true" style="--fabric-swatch-size: 3.5rem; --fabric-swatch-count: 1;"{% endif %}
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            {%- unless is_fabric_option and block_settings.use_fabric_disclosure != false -%}
              <legend>
                {%- if is_fabric_option -%}
                  {{ block_settings.fabric_heading | default: '1. Choose Your Fabric' }}
                {%- else -%}
                  {{ product_option.name | escape }}
                {%- endif -%}
                {%- if option_variant_style == 'swatch' -%}
                  <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
                {%- endif %}
              </legend>
            {%- else -%}
              <legend class="visually-hidden">{{ block_settings.fabric_heading | default: '1. Choose Your Fabric' }}</legend>
            {%- endunless -%}
            {%- if is_fabric_option -%}
              <div class="variant-option__fabric-track">
            {%- endif -%}
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
              <label
                class="{% if is_fabric_option %}variant-option__fabric-item{% else %}variant-option__button-label{% if option_variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name }}"
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if is_fabric_option %}
                    data-fabric-key="{{ product_option_value.name | handleize }}"
                  {% endif %}
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if product_option_value.selected %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >
                {% if option_variant_style == 'swatch' %}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media

                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}

                  {%- if is_fabric_option -%}
                    {%- liquid
                      assign swatch_bg = ''
                      if product_option_value.swatch.color
                        assign swatch_bg = 'rgb(' | append: product_option_value.swatch.color.rgb | append: ')'
                      endif
                      if swatch_bg == blank and featured_media != nil
                        assign swatch_bg = 'transparent'
                      endif
                      if swatch_bg == blank
                        capture swatch_bg
                          render 'fabric-default-swatch-color', fabric_key: product_option_value.name | handleize
                        endcapture
                        assign swatch_bg = swatch_bg | strip
                      endif
                      assign is_light_swatch = false
                      assign swatch_downcase = swatch_bg | downcase
                      if swatch_downcase == '#fff' or swatch_downcase == '#ffffff' or swatch_downcase == 'white' or swatch_downcase contains 'f5f0' or swatch_downcase contains 'faf'
                        assign is_light_swatch = true
                      endif
                    -%}
                    <span class="fabric-picker__swatch-ring">
                      <span class="fabric-picker__swatch{% if is_light_swatch %} fabric-picker__swatch--light{% endif %}" style="--fabric-swatch-bg: {{ swatch_bg }};">
                        {%- if featured_media != nil -%}
                          {{
                            featured_media.preview_image
                            | image_url: width: 160
                            | image_tag:
                              loading: 'lazy',
                              alt: product_option_value.name,
                              class: 'fabric-picker__swatch-image'
                          }}
                        {%- endif -%}
                      </span>
                    </span>
                    <span class="fabric-picker__text">
                      <span class="fabric-picker__color-name">{{ product_option_value.name }}</span>
                      <span class="fabric-picker__fabric-type">{{ block_settings.default_fabric_type | default: 'Performance Velvet' }}</span>
                    </span>
                  {%- else -%}
                    {% render 'swatch',
                      swatch: product_option_value.swatch,
                      variant_image: featured_media,
                      mode: 'unscaled'
                    %}
                    <span class="variant-option__swatch-label">{{ product_option_value | escape }}</span>
                  {%- endif -%}
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {%- unless is_fabric_option -%}
                  {% render 'strikethrough-variant', product_option: product_option_value %}
                {%- endunless -%}
              </label>
            {%- endfor -%}
            {%- if is_fabric_option -%}
              </div>
            {%- endif -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- endcapture -%}
          {%- if is_fabric_option and block_settings.use_fabric_disclosure != false -%}
            {% render 'product-step-disclosure',
              heading: block_settings.fabric_heading | default: '1. Choose Your Fabric',
              content: fieldset_markup,
              open_by_default: block_settings.open_by_default | default: true, allow_false: true,
              disclosure_id: block.id,
              class: 'variant-picker__fabric-disclosure'
            %}
          {%- else -%}
            {{ fieldset_markup }}
          {%- endif -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {%
            # There is an opportunity to build a custom select component that will allow us to style the select element further (animation for dropdown, swatches shown in the dropdown options, etc)
            # It's too bad as it mean rebuilding baked in behaviours but I think we've already done that for the locale selectors
            # in dawn. So it might mean more time spent in setting it up but worth it for future updates/styling.
          %}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              # (original width / original height) x new height (20px at the moment) = new width
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>
{% endunless %}

{% stylesheet %}
  /* Variant picker container styles - unique to main variant picker */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers */
  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }

  .variant-option--fabric-grid {
    display: block;
    border: none;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 0;
  }

  .variant-option--buttons.variant-option--fabric-grid {
    display: block;
    flex-wrap: unset;
  }

  .variant-option--fabric-grid .variant-option__fabric-track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap-md) var(--gap-sm);
    width: 100%;
  }

  .variant-option--fabric-grid legend {
    font-size: var(--font-size--md);
    font-weight: 600;
    margin-bottom: var(--gap-md);
    padding: 0;
  }

  .variant-option--fabric-grid .variant-option__fabric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs);
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0.25rem;
    border: none;
    outline: none;
    background: transparent;
    cursor: pointer;
    text-align: center;
    position: relative;
    box-sizing: border-box;
    opacity: 1;
  }

  .variant-option--fabric-grid .variant-option__fabric-item:hover {
    opacity: 1;
  }

  .variant-option--fabric-grid .variant-option__fabric-item::before,
  .variant-option--fabric-grid .variant-option__fabric-item::after {
    display: none;
  }

  .variant-option--fabric-grid .variant-option__fabric-item input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .variant-option--fabric-grid .variant-option__fabric-item:has([data-option-available='false']) {
    opacity: 1;
    cursor: pointer;
  }

  .variant-option--fabric-grid label.variant-option__fabric-item:has(input[type='radio']),
  .variant-option--fabric-grid label.variant-option__fabric-item:has(input[type='radio']:disabled) {
    cursor: pointer;
  }

  .variant-option--fabric-grid .variant-option__fabric-item:has(:checked) {
    outline: none;
    border: none;
  }

  .variant-option--fabric-grid .fabric-picker__swatch-ring {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    line-height: 0;
    flex-shrink: 0;
  }

  .variant-option--fabric-grid .fabric-picker__swatch {
    display: block;
    width: var(--fabric-swatch-size, 3.5rem);
    height: var(--fabric-swatch-size, 3.5rem);
    border-radius: 50%;
    background-color: var(--fabric-swatch-bg, #cccccc);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
    overflow: hidden;
    flex-shrink: 0;
    opacity: 1;
    filter: none;
  }

  .variant-option--fabric-grid .variant-option__fabric-item:hover .fabric-picker__swatch-ring {
    box-shadow:
      0 0 0 2px var(--color-background),
      0 0 0 3px rgb(var(--color-foreground-rgb) / 0.35);
  }

  .variant-option--fabric-grid .fabric-picker__swatch-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  .variant-option--fabric-grid .variant-option__fabric-item:has(:checked) .fabric-picker__swatch-ring {
    box-shadow:
      0 0 0 2px var(--color-background),
      0 0 0 3px var(--announcement-bar-color);
  }

  .variant-option--fabric-grid .fabric-picker__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    width: 100%;
    min-width: 0;
    line-height: 1.25;
    overflow: visible;
  }

  .variant-option--fabric-grid .fabric-picker__color-name {
    font-size: var(--font-size--xs);
    font-weight: 600;
    color: var(--color-foreground);
    opacity: 1;
  }

  .variant-option--fabric-grid .fabric-picker__fabric-type {
    font-size: 0.6875rem;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    white-space: normal;
    overflow-wrap: anywhere;
    opacity: 1;
  }

  /* Prevent fabric-picker item sizing from affecting variant picker swatches */
  .variant-option--fabric-grid .fabric-picker__item,
  .variant-option--fabric-grid .variant-option__fabric-item {
    flex: unset;
  }

  @media screen and (max-width: 749px) {
    .variant-option--fabric-grid {
      overflow: hidden;
    }

    accordion-custom.variant-picker__fabric-disclosure .product-step-disclosure__details,
    accordion-custom.variant-picker__fabric-disclosure .product-step-disclosure__content {
      overflow-x: clip;
      overflow-y: visible;
      min-width: 0;
    }

    .variant-option--fabric-grid {
      --fabric-swatch-size: 4rem;
    }

    .variant-option--fabric-grid .variant-option__fabric-track {
      display: flex;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: var(--gap-sm);
      width: 100%;
      max-width: 100%;
      min-width: 0;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--padding-md);
      padding-block: 0.5rem 0.75rem;
      padding-inline-start: var(--padding-xs);
      padding-inline-end: max(var(--padding-lg), calc((100% - (2 * var(--gap-sm))) / 3));
      margin-inline: 0;
      scrollbar-width: none;
      box-sizing: border-box;
    }

    .variant-option--fabric-grid .variant-option__fabric-track::-webkit-scrollbar {
      display: none;
    }

    .variant-option--fabric-grid .variant-option__fabric-item {
      flex: 0 0 calc((100% - (2 * var(--gap-sm))) / 3);
      width: calc((100% - (2 * var(--gap-sm))) / 3);
      min-width: calc((100% - (2 * var(--gap-sm))) / 3);
      max-width: calc((100% - (2 * var(--gap-sm))) / 3);
      height: auto;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      padding-inline: 0.125rem;
      padding-block: 0.25rem;
      box-sizing: border-box;
    }

    .variant-option--fabric-grid .fabric-picker__text {
      width: 100%;
      min-width: 0;
      overflow: visible;
    }

    .variant-option--fabric-grid .fabric-picker__color-name {
      font-size: 0.6875rem;
      line-height: 1.35;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .variant-option--fabric-grid .fabric-picker__fabric-type {
      font-size: 0.625rem;
      line-height: 1.35;
      overflow-wrap: anywhere;
      word-break: break-word;
    }
  }
{% endstylesheet %}
