{%- doc -%}
  Edgewater main navigation — fixed labels and order.

  @param {string} variant - 'header', 'drawer', or 'mobile_bar'
  @param {object} block_settings - Header menu block settings
  @param {object} [section] - Header section
  @param {string} [color_scheme_classes] - Submenu color classes
  @param {string} [menu_content_type] - Mega menu content type
  @param {string} [ratio] - Mega menu aspect ratio
  @param {number} [image_border_radius] - Mega menu image radius
{%- enddoc -%}

{%- liquid
  assign variant = variant | default: 'header'

  assign collections_url = routes.collections_url
  if pages.collectionss != blank
    assign collections_url = pages.collectionss.url
  endif

  assign our_story_url = '/pages/about'
  if pages.about != blank
    assign our_story_url = pages.about.url
  endif

  assign showroom_url = '/pages/contact'
  if pages.contact != blank
    assign showroom_url = pages.contact.url
  endif

  assign contact_url = showroom_url

  assign collections_active = false
  if request.path == collections_url or template.name == 'list-collections' or template.name == 'collection'
    assign collections_active = true
  endif

  assign our_story_active = false
  if pages.about != blank and request.path == pages.about.url
    assign our_story_active = true
  endif

  assign showroom_active = false
  assign contact_active = false
  if pages.contact != blank and request.path == pages.contact.url
    assign contact_active = true
  endif
-%}

{%- if variant == 'drawer' -%}
  <li
    style="--menu-drawer-animation-index: 1;"
    class="menu-drawer__list-item--flat{% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}"
  >
    <a
      id="HeaderDrawer-collections"
      href="{{ collections_url }}"
      class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element focus-inset{% if collections_active %} menu-drawer__menu-item--active{% endif %}"
      {% if collections_active %}
        aria-current="page"
      {% endif %}
    >
      <span class="menu-drawer__menu-item-text wrap-text">Collections</span>
    </a>
  </li>
  <li
    style="--menu-drawer-animation-index: 2;"
    class="menu-drawer__list-item--flat{% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}"
  >
    <a
      id="HeaderDrawer-our-story"
      href="{{ our_story_url }}"
      class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element focus-inset{% if our_story_active %} menu-drawer__menu-item--active{% endif %}"
      {% if our_story_active %}
        aria-current="page"
      {% endif %}
    >
      <span class="menu-drawer__menu-item-text wrap-text">Our Story</span>
    </a>
  </li>
  <li
    style="--menu-drawer-animation-index: 3;"
    class="menu-drawer__list-item--flat{% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}"
  >
    <a
      id="HeaderDrawer-book-showroom"
      href="{{ showroom_url }}"
      class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element focus-inset{% if showroom_active %} menu-drawer__menu-item--active{% endif %}"
      {% if showroom_active %}
        aria-current="page"
      {% endif %}
    >
      <span class="menu-drawer__menu-item-text wrap-text">Book a Showroom Visit</span>
    </a>
  </li>
  <li
    style="--menu-drawer-animation-index: 4;"
    class="menu-drawer__list-item--flat{% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}"
  >
    <a
      id="HeaderDrawer-contact-us"
      href="{{ contact_url }}"
      class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element focus-inset{% if contact_active %} menu-drawer__menu-item--active{% endif %}"
      {% if contact_active %}
        aria-current="page"
      {% endif %}
    >
      <span class="menu-drawer__menu-item-text wrap-text">Contact Us</span>
    </a>
  </li>

{%- elsif variant == 'mobile_bar' -%}
  <li>
    <a href="{{ collections_url }}" class="menu-list__item{% if collections_active %} menu-list__item--active{% endif %}">Collections</a>
  </li>
  <li>
    <a href="{{ our_story_url }}" class="menu-list__item{% if our_story_active %} menu-list__item--active{% endif %}">Our Story</a>
  </li>
  <li>
    <a href="{{ showroom_url }}" class="menu-list__item{% if showroom_active %} menu-list__item--active{% endif %}">Book a Showroom Visit</a>
  </li>
  <li>
    <a href="{{ contact_url }}" class="menu-list__item{% if contact_active %} menu-list__item--active{% endif %}">Contact Us</a>
  </li>

{%- else -%}
  <li
    role="presentation"
    class="menu-list__list-item menu__collection-dropdown"
    on:focus="/activate"
    on:blur="/deactivate"
    on:pointerenter="/activate"
    on:pointerleave="/deactivate"
  >
    <a
      href="{{ collections_url }}"
      data-skip-node-update="true"
      class="menu-list__link{% if collections_active %} menu-list__link--active{% endif %}"
      ref="menuitem"
    >
      <span class="menu-list__link-title">Collections</span>
    </a>
    <div class="menu-list__dropdown">
      {% for collection in block_settings.collection_dropdown_list %}
        <a href="{{ collection.url }}">
          <div class="collection-dropdown__item">
            {% if collection.image %}
              <div class="collection-dropdown__imag">
                <img
                  src="{{ collection.featured_image | image_url }}"
                  width="100%"
                  height="auto"
                  alt="{{ collection.featured_image.alt }}"
                  loading="lazy"
                  role="presentation"
                >
              </div>
            {% endif %}
            {% if collection.title %}
              <h3 class="collection-dropdown__title">{{ collection.title }}</h3>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
    <div class="menu-list__dropdown-overlay"></div>
  </li>

  <li
    role="presentation"
    class="menu-list__list-item"
    on:focus="/activate"
    on:blur="/deactivate"
    on:pointerenter="/activate"
    on:pointerleave="/deactivate"
  >
    <a
      href="{{ our_story_url }}"
      data-skip-node-update="true"
      class="menu-list__link{% if our_story_active %} menu-list__link--active{% endif %}"
      ref="menuitem"
    >
      <span class="menu-list__link-title">Our Story</span>
    </a>
  </li>

  <li
    role="presentation"
    class="menu-list__list-item"
    on:focus="/activate"
    on:blur="/deactivate"
    on:pointerenter="/activate"
    on:pointerleave="/deactivate"
  >
    <a
      href="{{ showroom_url }}"
      data-skip-node-update="true"
      class="menu-list__link{% if showroom_active %} menu-list__link--active{% endif %}"
      ref="menuitem"
    >
      <span class="menu-list__link-title">Book a Showroom Visit</span>
    </a>
  </li>

  <li
    role="presentation"
    class="menu-list__list-item"
    on:focus="/activate"
    on:blur="/deactivate"
    on:pointerenter="/activate"
    on:pointerleave="/deactivate"
  >
    <a
      href="{{ contact_url }}"
      data-skip-node-update="true"
      class="menu-list__link{% if contact_active %} menu-list__link--active{% endif %}"
      ref="menuitem"
    >
      <span class="menu-list__link-title">Contact Us</span>
    </a>
  </li>
{%- endif -%}
