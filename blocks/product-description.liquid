
{% liquid
  assign product = closest.product

  assign linked_collection = closest.collection
  if linked_collection == blank
    assign linked_collection = collection
  endif
  if linked_collection == blank and product != blank and product.collections.size > 0
    assign template_suffix = template.suffix | downcase
    for coll in product.collections
      assign coll_handle = coll.handle | downcase
      if template_suffix contains 'dremcloud' or template_suffix contains 'dream-cloud'
        if coll_handle contains 'dream-cloud'
          assign linked_collection = coll
          break
        endif
      elsif template_suffix contains 'xlcloud' or template_suffix contains 'xl-cloud'
        if coll_handle contains 'xl-cloud'
          assign linked_collection = coll
          break
        endif
      elsif template_suffix contains 'westcoast' or template_suffix contains 'west-coast'
        if coll_handle contains 'west-coast'
          assign linked_collection = coll
          break
        endif
      endif
    endfor
    if linked_collection == blank
      assign linked_collection = product.collections.first
    endif
  endif

  assign description_text = linked_collection.description
  if description_text == blank and product != blank
    assign description_text = product.description
  endif

  if request.visual_preview_mode and description_text == blank
    assign preview_product = collections.all.products.first
    if preview_product != blank
      assign description_text = preview_product.collections.first.description | default: preview_product.description
    endif
  endif
%}

{% render 'text', fallback_text: description_text, block: block %}

