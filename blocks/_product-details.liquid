

{%- liquid
  assign block_settings = block.settings
  capture xl_cloud_product_capture
    render 'xl-cloud-product-active', product_resource: closest.product
  endcapture
  assign is_xl_cloud_product = false
  if xl_cloud_product_capture == 'true'
    assign is_xl_cloud_product = true
  endif
  capture west_coast_product_capture
    render 'west-coast-product-active', product_resource: closest.product
  endcapture
  assign is_west_coast_product = false
  if west_coast_product_capture == 'true'
    assign is_west_coast_product = true
  endif
-%}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if is_xl_cloud_product %} product-details--xl-cloud{% endif %}
    {% if is_west_coast_product %} product-details--west-coast{% endif %}
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="--details-position: {{ block_settings.details_position }};"
  data-testid="product-information-details"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    <div class="view-product-title">
      <a
        href="{{ closest.product.selected_or_first_available_variant.url }}"
        class="link"
      >
        {{- closest.product.title }}
      </a>
    </div>
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'group', children: children, settings: block_settings, shopify_attributes: block.shopify_attributes %}
</div>

{% stylesheet %}
  /* Clear padding on mobile, if not full-width */
  @media screen and (max-width: 749px) {
    .product-information.section--page-width .product-details > .group-block {
      padding-inline: 0;
    }
  }

  .view-product-title {
    display: none;
  }

  /* Container styles */
  .product-details {
    display: flex;
    align-self: start;
    justify-content: flex-start;
    width: 100%;
    max-width: var(--product-details-max-width, 420px);
  }

  @media screen and (max-width: 749px) {
    .product-details {
      max-width: 100%;
    }
  }

  .product-details > .group-block {
    width: 100%;
    gap: var(--gap-md);
  }

  .product-details .group-block-content.layout-panel-flex {
    height: auto;
    justify-content: flex-start;
    --vertical-alignment: flex-start;
    --vertical-alignment-mobile: flex-start;
  }

  .product-details .accordion {
    flex: 0 0 auto;
    width: 100%;
    margin-top: 0;
  }

  .product-details product-price .price {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .product-details .installments {
    margin-top: var(--gap-2xs);
  }

  .product-details .product-details__purchase {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    width: 100%;
    padding-block-start: var(--gap-sm);
    padding-block-end: 0;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    margin-top: var(--gap-xs);
  }

  .product-details:has(modular-add-piece) .quantity-selector-wrapper,
  .product-details--xl-cloud .quantity-selector-wrapper,
  .product-details--west-coast .quantity-selector-wrapper {
    display: none;
  }

  .product-details:has(modular-add-piece) .product-form-buttons,
  .product-details--xl-cloud .product-form-buttons,
  .product-details--west-coast .product-form-buttons {
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .product-details:has(modular-add-piece) .add-to-cart-button,
  .product-details:has(modular-add-piece) .product-form-buttons > add-to-cart-component,
  .product-details--xl-cloud .add-to-cart-button,
  .product-details--xl-cloud .product-form-buttons > add-to-cart-component,
  .product-details--west-coast .add-to-cart-button,
  .product-details--west-coast .product-form-buttons > add-to-cart-component {
    flex: 1 1 100%;
    width: 100%;
    min-width: 100%;
  }

  .product-details:has(modular-add-piece) accelerated-checkout-block,
  .product-details:has(modular-add-piece) shopify-accelerated-checkout,
  .product-details--xl-cloud accelerated-checkout-block,
  .product-details--xl-cloud shopify-accelerated-checkout {
    display: none;
  }

  .product-details .buy-buttons-block {
    width: 100%;
  }

  .product-details .fabric-picker,
  .product-details .variant-picker,
  .product-details .modular-add-piece {
    width: 100%;
  }

  .product-information.has-gg-swatches .variant-picker__fabric-disclosure .product-step-disclosure__content,
  .product-information.has-gg-swatches .variant-picker__fabric-disclosure .variant-option--fabric-grid,
  .product-information.has-gg-swatches .variant-picker__fabric-disclosure .product-step-disclosure__content > fieldset,
  .product-information.has-gg-swatches .variant-picker__fabric-disclosure fieldset[data-fabric-option] {
    display: none !important;
  }

  .product-information.has-gg-swatches .variant-picker + gg-swatch {
    display: block !important;
    width: 100%;
    margin-block-start: var(--gap-lg);
  }

  .product-details .product-step-disclosure__details {
    border-block-start: none;
  }

  .product-details .product-step-disclosure__summary,
  .product-details .variant-option--fabric-grid legend {
    color: var(--announcement-bar-text);
    background-color: var(--announcement-bar-color);
    padding: var(--padding-md) var(--padding-lg);
    border-radius: var(--style-border-radius-buttons-primary, 4px);
  }

  .product-information:not(.has-gg-swatches) .product-details:not(:has(fabric-picker)):not(:has(.variant-option--fabric-grid)):not(:has(gg-swatch)):not(:has(.gg-swatch)) .modular-add-piece__disclosure .product-step-disclosure__summary {
    margin-block-start: 0;
  }

  .modular-add-piece__disclosure .product-step-disclosure__heading-no-fabric {
    display: none;
  }

  .product-information.has-gg-swatches .modular-add-piece__disclosure .product-step-disclosure__summary,
  .product-details:has(fabric-picker) .modular-add-piece__disclosure .product-step-disclosure__summary,
  .product-details:has(.variant-option--fabric-grid) .modular-add-piece__disclosure .product-step-disclosure__summary,
  .product-details:has(gg-swatch) .modular-add-piece__disclosure .product-step-disclosure__summary,
  .product-details:has(.gg-swatch) .modular-add-piece__disclosure .product-step-disclosure__summary {
    margin-block-start: var(--gap-sm);
  }

  .product-information.has-gg-swatches .modular-add-piece__disclosure .product-step-disclosure__heading-no-fabric,
  .product-details:has(fabric-picker) .modular-add-piece__disclosure .product-step-disclosure__heading-no-fabric,
  .product-details:has(.variant-option--fabric-grid) .modular-add-piece__disclosure .product-step-disclosure__heading-no-fabric,
  .product-details:has(gg-swatch) .modular-add-piece__disclosure .product-step-disclosure__heading-no-fabric,
  .product-details:has(.gg-swatch) .modular-add-piece__disclosure .product-step-disclosure__heading-no-fabric {
    display: none;
  }

  .product-information:not(.has-gg-swatches) .product-details:not(:has(fabric-picker)):not(:has(.variant-option--fabric-grid)):not(:has(gg-swatch)):not(:has(.gg-swatch)) .modular-add-piece__disclosure .product-step-disclosure__heading-when-fabric {
    display: none;
  }

  .product-information:not(.has-gg-swatches) .product-details:not(:has(fabric-picker)):not(:has(.variant-option--fabric-grid)):not(:has(gg-swatch)):not(:has(.gg-swatch)) .modular-add-piece__disclosure .product-step-disclosure__heading-no-fabric {
    display: inline;
  }

  .product-details .product-step-disclosure__summary:hover {
    color: var(--announcement-bar-text);
    background-color: var(--announcement-bar-color-hover);
  }

  .product-details .product-step-disclosure__summary .svg-wrapper {
    color: inherit;
  }

  .product-details .add-to-cart-button.button:not(.button-secondary, .button-unstyled) {
    --button-color: var(--announcement-bar-text);
    --button-background-color: var(--announcement-bar-color);
    --button-border-color: var(--announcement-bar-color);
  }

  .product-details .add-to-cart-button.button:not(.button-secondary, .button-unstyled):hover:not([disabled], [aria-disabled='true']) {
    --button-color: var(--announcement-bar-text);
    --button-background-color: var(--announcement-bar-color-hover);
    --button-border-color: var(--announcement-bar-color-hover);
  }

  .product-details .add-to-cart-button--loading::after {
    border-color: rgb(255 255 255 / 0.25);
    border-top-color: var(--announcement-bar-text);
  }


  .add-to-cart-button--loading {
    opacity: 0.72;
    pointer-events: none;
  }

  .add-to-cart-button--loading .add-to-cart-text {
    visibility: hidden;
  }

  .add-to-cart-button--loading::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-top-color: var(--color-foreground);
    border-radius: 50%;
    animation: product-atc-spin 0.65s linear infinite;
  }

  @keyframes product-atc-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media screen and (max-width: 749px) {
    .product-details accordion-custom.variant-picker__fabric-disclosure .product-step-disclosure__details,
    .product-details accordion-custom.variant-picker__fabric-disclosure .product-step-disclosure__content {
      overflow-x: clip;
      overflow-y: visible;
      min-width: 0;
    }

    .product-details .variant-picker__fabric-disclosure .variant-option--fabric-grid {
      overflow: hidden;
      min-width: 0;
    }
  }

  @media screen and (min-width: 750px) {
    .product-details > .group-block {
      height: min-content;
    }

    .full-height--desktop {
      height: 100%;
      max-height: calc(100vh - var(--header-group-height, 0));
      min-height: fit-content;
    }

    .full-height--desktop .group-block {
      align-self: var(--details-position, 'flex-start');
    }
  }
{% endstylesheet %}

