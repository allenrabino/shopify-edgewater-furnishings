
{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign show_block = true

  assign template_suffix = template.suffix | downcase
  assign fixed_config_handles = 'pacific-l-shape-ottoman,juniper-l-shape-ottoman,cove-reversible-chaise-sofa,4pc-sofa-ottoman-configuration' | split: ','

  if fixed_config_handles contains product_resource.handle
    assign show_block = false
  endif

  if block_settings.hide_on_collection_templates
    if template_suffix == 'xlcloud' or template_suffix == 'xl-cloud' or template_suffix == 'westcoastcloud' or template_suffix == 'west-coast'
      assign show_block = false
    endif
  endif

  assign subproduct_count = 0
  for child_block in block.blocks
    if child_block.type == '_modular-subproduct' and child_block.settings.product != blank
      assign subproduct_count = subproduct_count | plus: 1
    endif
  endfor

  if subproduct_count == 0
    assign show_block = false
  endif

  assign base_price = product_resource.selected_or_first_available_variant.price
  assign pieces_total = 0

  for child_block in block.blocks
    if child_block.type == '_modular-subproduct'
      assign piece_product = child_block.settings.product
      if piece_product != blank
        assign piece_qty = 0
        if piece_product.handle == product_resource.handle
          assign piece_qty = 1
        endif
        assign piece_variant = piece_product.selected_or_first_available_variant
        assign pieces_total = pieces_total | plus: piece_variant.price | times: piece_qty
      endif
    endif
  endfor

  assign display_total = base_price | plus: pieces_total

  assign money_format = shop.money_format
  if settings.currency_code_enabled_product_pages
    assign money_format = shop.money_with_currency_format
  endif
-%}

{%- if show_block -%}
  <modular-add-piece
    class="modular-add-piece spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    data-base-price="{{ base_price }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-money-format="{{ money_format | escape }}"
    {{ block.shopify_attributes }}
  >
    <accordion-custom
      class="modular-add-piece__disclosure product-step-disclosure accordion--caret"
      {% if block_settings.open_by_default | default: true, allow_false: true %}
        open-by-default-on-desktop
        open-by-default-on-mobile
      {% endif %}
    >
      <details
        class="details product-step-disclosure__details"
        {% if block_settings.open_by_default | default: true, allow_false: true %}
          open
        {% endif %}
      >
        <summary
          class="details__header product-step-disclosure__summary"
          id="product-step-summary-{{ block.id }}"
        >
          <span class="product-step-disclosure__heading product-step-disclosure__heading--dual">
            <span class="product-step-disclosure__heading-when-fabric">
              {{ block_settings.heading | default: '2. Add a Piece' }}
            </span>
            <span class="product-step-disclosure__heading-no-fabric">
              {{ block_settings.heading_without_fabric | default: '1. Add a Piece' }}
            </span>
          </span>
          <span class="svg-wrapper icon-caret icon-animated">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper icon-plus">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </summary>

        <div class="details-content product-step-disclosure__content">
          {%- if block_settings.subheading != blank -%}
            <p class="modular-add-piece__subheading">{{ block_settings.subheading }}</p>
          {%- endif -%}

          <div class="modular-add-piece__pieces">
            {% content_for 'blocks' %}
          </div>

          <div class="modular-add-piece__total">
            <span>{{ block_settings.total_label }}</span>
            <strong data-total-display>{{ display_total | money_with_currency }}</strong>
          </div>
        </div>
      </details>
    </accordion-custom>
  </modular-add-piece>

  <script src="{{ 'modular-add-piece.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .modular-add-piece {
    width: 100%;
  }

  .modular-add-piece__subheading {
    margin: 0 0 var(--gap-md);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .modular-add-piece__pieces {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .modular-add-piece__card {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--gap-sm);
    width: 100%;
    min-width: 0;
    padding: var(--gap-sm);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: var(--style-border-radius-popover, 4px);
    background: rgb(var(--color-background-rgb) / 1);
    box-sizing: border-box;
  }

  .modular-subproduct-card__media {
    aspect-ratio: 1;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    border-radius: var(--style-border-radius-popover, 4px);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modular-subproduct-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .modular-subproduct-card__placeholder {
    width: 70%;
    height: auto;
    opacity: 0.3;
  }

  .modular-subproduct-card__info {
    min-width: 0;
    text-align: left;
  }

  .modular-subproduct-card__title {
    margin: 0 0 0.125rem;
    font-size: var(--font-size--sm);
    font-weight: 500;
    line-height: 1.35;
  }

  .modular-subproduct-card__price {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .modular-add-piece__qty {
    --modular-qty-width: 7.75rem;

    display: inline-flex;
    align-items: stretch;
    justify-content: space-between;
    width: var(--modular-qty-width);
    min-width: var(--modular-qty-width);
    flex-shrink: 0;
    color: var(--color-input-text, var(--color-foreground));
    background-color: var(--color-input-background, rgb(var(--color-foreground-rgb) / 0.04));
    border: var(--style-border-width-inputs, 1px) solid var(--color-input-border, rgb(var(--color-foreground-rgb) / 0.85));
    border-radius: var(--style-border-radius-buttons-primary, 999px);
    overflow: hidden;
    transition: background-color 0.15s ease;
  }

  .modular-add-piece__qty:hover {
    background-color: var(--color-input-hover-background, rgb(var(--color-foreground-rgb) / 0.06));
  }

  .modular-add-piece__qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 2.5rem;
    width: 2.5rem;
    min-height: 2.5rem;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    box-shadow: none;
    cursor: pointer;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1;
    color: inherit;
    transition: opacity 0.15s ease;
  }

  .modular-add-piece__qty-btn:hover {
    opacity: 0.65;
  }

  .modular-add-piece__qty-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .modular-add-piece__qty-input {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0.5rem 0.25rem;
    text-align: center;
    border: none;
    background: transparent;
    font-size: var(--font-size--sm);
    font-weight: 500;
    color: inherit;
    appearance: none;
    -moz-appearance: textfield;
  }

  .modular-add-piece__qty-input::-webkit-inner-spin-button,
  .modular-add-piece__qty-input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }

  .modular-add-piece__total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--gap-md);
    padding-top: var(--gap-md);
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    font-size: var(--font-size--md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.modular_add_piece",
  "tag": null,
  "blocks": [
    {
      "type": "_modular-subproduct"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "2. Add a Piece",
      "info": "Used when Choose Your Fabric is shown above."
    },
    {
      "type": "text",
      "id": "heading_without_fabric",
      "label": "Heading without fabric step",
      "default": "1. Add a Piece",
      "info": "Used when this product has no fabric picker (step 1)."
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open section by default",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "Choose your pieces and quantity to build your perfect configuration."
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "t:settings.total_label",
      "default": "Configuration total"
    },
    {
      "type": "paragraph",
      "content": "t:info.modular_subproducts_blocks"
    },
    {
      "type": "checkbox",
      "id": "hide_on_collection_templates",
      "label": "t:settings.hide_on_xl_cloud",
      "default": true,
      "info": "t:info.hide_modular_xl_cloud"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.modular_add_piece",
      "category": "t:categories.product",
      "blocks": [
        {
          "type": "_modular-subproduct",
          "settings": {
            "label": "Single Corner"
          }
        },
        {
          "type": "_modular-subproduct",
          "settings": {
            "label": "Armless Chair"
          }
        },
        {
          "type": "_modular-subproduct",
          "settings": {
            "label": "Ottoman"
          }
        }
      ]
    }
  ]
}
{% endschema %}
