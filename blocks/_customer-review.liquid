
{%- liquid
  assign block_settings = block.settings
  assign rating = block_settings.rating | default: 5
  assign star_count = 5
  assign verified_label = block_settings.verified_label | default: 'Verified Buyer'
-%}

<article class="customer-review" {{ block.shopify_attributes }}>
  <div class="customer-review__stars" aria-label="{{ rating }} out of 5 stars">
    {%- for i in (1..star_count) -%}
      <span class="customer-review__star{% if i <= rating %} customer-review__star--filled{% endif %}" aria-hidden="true">★</span>
    {%- endfor -%}
  </div>

  {%- if block_settings.quote != blank -%}
    <blockquote class="customer-review__quote">{{ block_settings.quote }}</blockquote>
  {%- endif -%}

  <footer class="customer-review__footer">
    {%- if block_settings.author != blank -%}
      <cite class="customer-review__author">{{ block_settings.author }}</cite>
    {%- endif -%}
    {%- if verified_label != blank -%}
      <span class="customer-review__verified">{{ verified_label }}</span>
    {%- endif -%}
  </footer>
</article>

{% stylesheet %}
  .customer-review {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
    box-sizing: border-box;
    height: var(--customer-review-card-height, 15.5rem);
    min-height: var(--customer-review-card-height, 15.5rem);
    max-height: var(--customer-review-card-height, 15.5rem);
    padding: 1.25rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 12px;
    background: #fff;
    text-align: left;
    overflow: hidden;
  }

  .customer-review__stars {
    display: flex;
    gap: 0.15rem;
    line-height: 1;
  }

  .customer-review__star {
    font-size: 1.125rem;
    color: rgb(var(--announcement-bar-color-rgb) / 0.25);
    letter-spacing: 0.05em;
  }

  .customer-review__star--filled {
    color: var(--announcement-bar-color);
  }

  .customer-review__quote {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    margin: 0;
    padding: 0 0.25rem 0 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    font-size: var(--font-size--sm);
    line-height: 1.45;
    color: var(--color-foreground);
    font-style: normal;
    text-align: left;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--announcement-bar-color-rgb) / 0.45) transparent;
  }

  .customer-review__quote::-webkit-scrollbar {
    width: 5px;
  }

  .customer-review__quote::-webkit-scrollbar-track {
    margin-block: 0.125rem;
    background: rgb(var(--color-foreground-rgb) / 0.06);
    border-radius: 999px;
  }

  .customer-review__quote::-webkit-scrollbar-thumb {
    background: rgb(var(--announcement-bar-color-rgb) / 0.45);
    border-radius: 999px;
  }

  .customer-review__quote > *:first-child {
    margin-block-start: 0;
  }

  .customer-review__quote > *:last-child {
    margin-block-end: 0;
  }

  .customer-review__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-shrink: 0;
    gap: 0.25rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .customer-review__author {
    font-size: var(--font-size--sm);
    font-weight: 700;
    font-style: normal;
    color: var(--color-foreground);
    line-height: 1.3;
  }

  .customer-review__verified {
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer review",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "quote",
      "label": "Review text",
      "default": "<p>Beautiful sofa and great communication throughout the order.</p>"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Customer name",
      "default": "Catherine"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified label",
      "default": "Verified Buyer"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Star rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Customer review"
    }
  ]
}
{% endschema %}
