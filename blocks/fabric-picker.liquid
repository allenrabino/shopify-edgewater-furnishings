
{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign fabric_input_name = 'fabric-' | append: section.id | append: '-' | append: product_resource.id

  assign product_fabric_step_evaluated = true
  assign product_has_fabric_step = false

  assign force_hide_picker = false
  assign hidden_handles_raw = block_settings.hidden_product_handles | downcase | strip
  assign default_hidden_handles = 'pacific-l-shape-ottoman,juniper-l-shape-ottoman,cove-reversible-chaise-sofa,4pc-sofa-ottoman-configuration' | split: ','
  assign hidden_handles = default_hidden_handles
  if hidden_handles_raw != blank
    assign hidden_handles = hidden_handles_raw | split: ','
  endif
  for hidden_handle in hidden_handles
    assign hidden_handle_normalized = hidden_handle | strip
    if product_resource.handle == hidden_handle_normalized
      assign force_hide_picker = true
      break
    endif
  endfor

  assign use_variant_picker = false
  unless product_resource.has_only_default_variant
    for product_option in product_resource.options_with_values
      assign option_name_downcase = product_option.name | downcase
      if option_name_downcase contains 'fabric' or option_name_downcase contains 'color' or option_name_downcase contains 'colour' or option_name_downcase contains 'material'
        assign use_variant_picker = true
        break
      endif
    endfor
  endunless

  if use_variant_picker
    assign product_has_fabric_step = true
  endif

  assign allowed_fabric_keys_raw = block_settings.allowed_fabric_keys | downcase | strip
  assign has_allowed_fabric_keys = false
  if allowed_fabric_keys_raw != blank
    assign has_allowed_fabric_keys = true
  endif

  assign fabric_color_block_count = 0
  for child_block in block.blocks
    if child_block.type == '_fabric-color'
      assign fabric_color_block_count = fabric_color_block_count | plus: 1
    endif
  endfor

  assign use_admin_colors = false
  if fabric_color_block_count > 0
    assign use_admin_colors = true
  endif

  assign fabric_entries_delimited = ''
  assign default_fabric_key = ''
  unless use_admin_colors
    for media in product_resource.media
      capture fabric_key
        render 'fabric-meta-from-media', media: media, part: 'key'
      endcapture
      assign fabric_key = fabric_key | strip
      if fabric_key != blank
        assign include_fabric = true
        if has_allowed_fabric_keys
          assign include_fabric = false
          assign allowed_keys = allowed_fabric_keys_raw | split: ','
          for allowed_key in allowed_keys
            assign allowed_key_normalized = allowed_key | strip
            if fabric_key == allowed_key_normalized or fabric_key contains allowed_key_normalized
              assign include_fabric = true
              break
            endif
          endfor
        endif
        if include_fabric
          capture color_name
            render 'fabric-meta-from-media', media: media, part: 'color', default_fabric_type: block_settings.default_fabric_type
          endcapture
          capture fabric_type
            render 'fabric-meta-from-media', media: media, part: 'type', default_fabric_type: block_settings.default_fabric_type
          endcapture
          assign color_name = color_name | strip
          assign fabric_type = fabric_type | strip
          unless fabric_entries_delimited contains fabric_key
            if fabric_entries_delimited != blank
              assign fabric_entries_delimited = fabric_entries_delimited | append: '~~~'
            endif
            assign fabric_entries_delimited = fabric_entries_delimited | append: fabric_key | append: '::' | append: color_name | append: '::' | append: fabric_type
            if default_fabric_key == blank
              assign default_fabric_key = fabric_key
            endif
          endunless
        endif
      endif
    endfor
  endunless
  assign fabric_entries = fabric_entries_delimited | split: '~~~'

  assign visible_admin_count = 0
  if use_admin_colors
    for child_block in block.blocks
      if child_block.type == '_fabric-color'
        assign child_key = child_block.settings.fabric_key | strip | downcase
        if child_key == blank
          assign child_key = child_block.settings.color_name | handleize
        endif
        assign include_child = true
        if has_allowed_fabric_keys
          assign include_child = false
          assign allowed_keys = allowed_fabric_keys_raw | split: ','
          for allowed_key in allowed_keys
            assign allowed_key_normalized = allowed_key | strip
            if child_key == allowed_key_normalized or child_key contains allowed_key_normalized
              assign include_child = true
              break
            endif
          endfor
        endif
        if include_child
          assign visible_admin_count = visible_admin_count | plus: 1
        endif
      endif
    endfor
  endif

  assign show_picker = false
  unless force_hide_picker
    if use_admin_colors and visible_admin_count >= 2
      assign show_picker = true
    elsif fabric_entries.size >= 2
      assign show_picker = true
    endif
  endunless

  if show_picker
    assign product_has_fabric_step = true
  endif

  if force_hide_picker
    assign product_has_fabric_step = false
    assign show_picker = false
  endif

  assign fabric_swatch_count = fabric_entries.size
  if use_admin_colors
    assign fabric_swatch_count = visible_admin_count
  endif

  assign fabric_visible_per_page = block_settings.columns | plus: 0
  if fabric_visible_per_page == 0
    assign fabric_visible_per_page = 4
  endif
  if fabric_visible_per_page > 4
    assign fabric_visible_per_page = 4
  endif
-%}

{%- unless use_variant_picker or show_picker == false -%}
  <fabric-picker
    class="fabric-picker spacing-style"
    style="{% render 'spacing-style', settings: block_settings %} --fabric-visible-per-page: {{ fabric_visible_per_page }}; --fabric-swatch-count: {{ fabric_swatch_count }}; --fabric-swatch-size: {{ block_settings.swatch_size }}px;"
    data-section-id="{{ section.id }}"
    data-visible-per-page="{{ fabric_visible_per_page }}"
    data-swatch-count="{{ fabric_swatch_count }}"
    {{ block.shopify_attributes }}
  >
    {% capture fabric_picker_body %}
      <fieldset
        class="fabric-picker__fieldset"
        ref="fieldsets[]"
        aria-labelledby="product-step-summary-{{ block.id }}"
      >
        <div
          class="fabric-picker__carousel{% if fabric_swatch_count <= fabric_visible_per_page %} fabric-picker__carousel--static{% endif %}"
          ref="carousel"
        >
          <button
            type="button"
            class="fabric-picker__nav fabric-picker__nav--prev"
            ref="prevNav"
            aria-label="Previous fabric colors"
            hidden
          >
            <span class="svg-wrapper icon-caret icon-caret--prev" aria-hidden="true">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>

          <div class="fabric-picker__viewport" ref="viewport">
            <div class="fabric-picker__track" ref="track">
              <div class="fabric-picker__swatches">
        {%- if use_admin_colors -%}
          {%- assign is_first_visible = true -%}
          {%- for child_block in block.blocks -%}
            {%- if child_block.type == '_fabric-color' -%}
              {%- liquid
                assign child_settings = child_block.settings
                assign fabric_key = child_settings.fabric_key | strip | downcase
                if fabric_key == blank
                  assign fabric_key = child_settings.color_name | handleize
                endif
                assign include_child = true
                if has_allowed_fabric_keys
                  assign include_child = false
                  assign allowed_keys = allowed_fabric_keys_raw | split: ','
                  for allowed_key in allowed_keys
                    assign allowed_key_normalized = allowed_key | strip
                    if fabric_key == allowed_key_normalized or fabric_key contains allowed_key_normalized
                      assign include_child = true
                      break
                    endif
                  endfor
                endif
              -%}
              {%- if include_child -%}
                {%- liquid
                  assign swatch_color = child_settings.swatch_color
                  if swatch_color == blank
                    capture swatch_color
                      render 'fabric-default-swatch-color', fabric_key: fabric_key
                    endcapture
                    assign swatch_color = swatch_color | strip
                  endif
                  assign is_checked = false
                  if is_first_visible
                    assign is_checked = true
                    assign is_first_visible = false
                  endif
                -%}
                {% render 'fabric-swatch',
                  fabric_key: fabric_key,
                  color_name: child_settings.color_name,
                  fabric_type: child_settings.fabric_type,
                  swatch_color: swatch_color,
                  input_name: fabric_input_name,
                  checked: is_checked,
                  shopify_attributes: child_block.shopify_attributes
                %}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for entry in fabric_entries -%}
            {%- liquid
              assign entry_parts = entry | split: '::'
              assign fabric_key = entry_parts[0]
              assign color_name = entry_parts[1]
              assign fabric_type = entry_parts[2]
              assign is_checked = false
              if fabric_key == default_fabric_key
                assign is_checked = true
              endif
              capture swatch_color
                render 'fabric-default-swatch-color', fabric_key: fabric_key
              endcapture
              assign swatch_color = swatch_color | strip
            -%}
            {% render 'fabric-swatch',
              fabric_key: fabric_key,
              color_name: color_name,
              fabric_type: fabric_type,
              swatch_color: swatch_color,
              input_name: fabric_input_name,
              checked: is_checked
            %}
          {%- endfor -%}
        {%- endif -%}
              </div>
            </div>
          </div>

          <button
            type="button"
            class="fabric-picker__nav fabric-picker__nav--next"
            ref="nextNav"
            aria-label="Next fabric colors"
            {% if fabric_swatch_count <= fabric_visible_per_page %}
              hidden
            {% endif %}
          >
            <span class="svg-wrapper icon-caret icon-caret--next" aria-hidden="true">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </fieldset>
    {% endcapture %}

    {% render 'product-step-disclosure',
      heading: block_settings.heading,
      content: fabric_picker_body,
      open_by_default: block_settings.open_by_default | default: true, allow_false: true,
      disclosure_id: block.id,
      class: 'fabric-picker__disclosure'
    %}
  </fabric-picker>
{%- endunless -%}

{% stylesheet %}
  .fabric-picker {
    width: 100%;
    max-width: 100%;
  }

  .fabric-picker__disclosure {
    width: 100%;
  }

  .fabric-picker__fieldset {
    border: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    width: 100%;
  }

  .fabric-picker__carousel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--gap-xs);
    width: 100%;
  }

  .fabric-picker__carousel--static {
    grid-template-columns: minmax(0, 1fr);
  }

  .fabric-picker__carousel--static .fabric-picker__nav {
    display: none;
  }

  .fabric-picker__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    padding: 0;
    margin: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .fabric-picker__nav:hover:not(:disabled) {
    border-color: var(--announcement-bar-color);
    color: var(--announcement-bar-color);
  }

  .fabric-picker__nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .fabric-picker__nav .icon-caret--prev {
    transform: rotate(90deg);
  }

  .fabric-picker__nav .icon-caret--next {
    transform: rotate(-90deg);
  }

  .fabric-picker__viewport {
    overflow: hidden;
    width: 100%;
    min-width: 0;
  }

  .fabric-picker__track {
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .fabric-picker__swatches {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--gap-sm);
    width: calc(var(--fabric-swatch-count) / var(--fabric-visible-per-page) * 100%);
    min-width: 100%;
    padding-block: 0.125rem;
    padding-inline: 0.125rem;
    box-sizing: border-box;
  }

  .fabric-picker__carousel--static .fabric-picker__swatches {
    width: 100%;
  }

  .fabric-picker__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs);
    margin: 0;
    padding: 0.25rem;
    border: none;
    background: transparent;
    cursor: pointer;
    text-align: center;
    min-width: 0;
    flex: 0 0 calc(100% / var(--fabric-swatch-count));
    box-sizing: border-box;
  }

  .fabric-picker__carousel--static .fabric-picker__item {
    flex: 1 1 0;
  }

  .fabric-picker__swatch-ring {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    line-height: 0;
    flex-shrink: 0;
  }

  .fabric-picker__item::before,
  .fabric-picker__item::after {
    display: none;
  }

  .fabric-picker__item input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    margin: 0;
    pointer-events: none;
  }

  .fabric-picker__swatch {
    display: block;
    width: var(--fabric-swatch-size, 3.5rem);
    height: var(--fabric-swatch-size, 3.5rem);
    border-radius: 50%;
    background-color: var(--fabric-swatch-bg, #cccccc);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
    transition: box-shadow 0.15s ease;
    flex-shrink: 0;
  }

  .fabric-picker__swatch--light {
    border-color: rgb(var(--color-foreground-rgb) / 0.22);
  }

  .fabric-picker__item:has(:checked) .fabric-picker__swatch-ring {
    box-shadow:
      0 0 0 2px var(--color-background),
      0 0 0 3px var(--announcement-bar-color);
  }

  .fabric-picker__item:has(:checked) .fabric-picker__swatch {
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .fabric-picker__item:has(:focus-visible) .fabric-picker__swatch-ring {
    outline: 2px solid var(--announcement-bar-color);
    outline-offset: 2px;
  }

  .fabric-picker__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    width: 100%;
    line-height: 1.25;
  }

  .fabric-picker__color-name {
    font-size: var(--font-size--xs);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .fabric-picker__fabric-type {
    font-size: 0.6875rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  @media screen and (max-width: 749px) {
    .fabric-picker__nav {
      width: 1.75rem;
      height: 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.fabric_picker",
  "tag": null,
  "blocks": [
    {
      "type": "_fabric-color"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "1. Choose Your Fabric"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open section by default",
      "default": true
    },
    {
      "type": "text",
      "id": "default_fabric_type",
      "label": "t:settings.default_fabric_type",
      "default": "Performance Velvet",
      "info": "t:info.default_fabric_type_fallback"
    },
    {
      "type": "text",
      "id": "allowed_fabric_keys",
      "label": "t:settings.allowed_fabric_keys",
      "info": "t:info.allowed_fabric_keys"
    },
    {
      "type": "textarea",
      "id": "hidden_product_handles",
      "label": "Hide fabric picker on products",
      "info": "Comma-separated product handles that should not show Choose Your Fabric (e.g. 6pc-pit, 4pc-sofa-ottoman-configuration)."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Colors visible at once",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4",
      "info": "Additional colors appear when shoppers use the slide arrows."
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "t:settings.swatch_size",
      "min": 40,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "t:content.fabric_colors"
    },
    {
      "type": "paragraph",
      "content": "t:info.fabric_colors_admin"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.fabric_picker",
      "category": "t:categories.product",
      "blocks": [
        {
          "type": "_fabric-color",
          "settings": {
            "color_name": "White",
            "fabric_key": "cream-oatmeal",
            "swatch_color": "#ffffff",
            "fabric_type": "Performance Velvet"
          }
        },
        {
          "type": "_fabric-color",
          "settings": {
            "color_name": "Black",
            "fabric_key": "sand",
            "swatch_color": "#1a1a1a",
            "fabric_type": "Performance Velvet"
          }
        }
      ]
    }
  ]
}
{% endschema %}
